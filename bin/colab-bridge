#!/usr/bin/env python3
"""Thin CLI over the lobby bridge (plan: .plans/2026-11-01-lobby-bridge.md).

Usage: colab-bridge status|children|log [--tail N]|ping [--wait S]|cmd [--target T] [--timeout S] [--wait S] <shell...>|mint <profile> [--name N] [--wait S]|stop <name> [--wait S]

The client plants a signed command file into the bridge queue in
the standing lobby and waits (bounded) for its terminal line in the
bridge log. Exit codes: for `cmd`, the command's own rc when a
result arrived; 2 for bridge-level failures (no lobby, plant
failed, wait timed out — the command may still land later; `log`
and the local mirror keep it). File-only drivers skip this client
entirely: drop a signed command into var/bridge-outbox/ and read
var/bridge-mirror.jsonl — the ferry (in the reaper's standing pass)
moves both.
"""

import importlib.util
import json
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "bin"))

spec = importlib.util.spec_from_loader("colab_run", SourceFileLoader("colab_run", str(REPO / "bin" / "colab-run")))
cr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(cr)

spec_l = importlib.util.spec_from_file_location("lease", REPO / "sync" / "lease.py")
lease = importlib.util.module_from_spec(spec_l)
spec_l.loader.exec_module(lease)

TERMINAL = ("result", "mint", "stop", "pong", "error", "duplicate")


def lobby_session() -> tuple[str | None, str | None]:
    grant = lease.load_grant(REPO)
    cfg = lease.load_config(REPO)
    profile = (grant or {}).get("lobby_profile") or cfg.get("standing", {}).get("profile", "lobby")
    rec = lease.load_record(REPO, profile)
    if not rec:
        return None, profile
    return rec["session"], profile


def plant(session: str, cmd: dict) -> bool:
    var = lease.var_dir(REPO)
    var.mkdir(parents=True, exist_ok=True)
    local = var / f"bridge-cmd-{cmd['id']}.json"
    local.write_text(json.dumps(cmd))
    try:
        r = cr.colab("upload", "-s", session, str(local), f"{lease.BRIDGE_REMOTE}/queue/{cmd['id']}.json", timeout=30)
        return r.returncode == 0
    except Exception:  # noqa: BLE001
        return False
    finally:
        local.unlink(missing_ok=True)


def scan_log(session: str, cid: str) -> dict | None:
    status = lease.bridge_status_read(cr.colab, REPO, session)
    if status is None:
        return None
    segment = status.get("log_segment") or "bridge-000001.jsonl"
    dest = lease.var_dir(REPO) / "bridge-client-dl.jsonl"
    try:
        r = cr.colab("download", "-s", session, f"{lease.BRIDGE_REMOTE}/log/{segment}", str(dest), timeout=30)
        if r.returncode != 0 or not dest.exists():
            return None
        found = None
        for raw in dest.read_text(errors="replace").splitlines():
            try:
                line = json.loads(raw)
            except json.JSONDecodeError:
                continue
            if isinstance(line, dict) and line.get("id") == cid and line.get("kind") in TERMINAL:
                found = line
        return found
    except Exception:  # noqa: BLE001
        return None


def plant_and_wait(session: str, cmd: dict, wait_s: float) -> dict:
    if not plant(session, cmd):
        return {"bridge": "plant-failed", "id": cmd["id"]}
    deadline = time.monotonic() + wait_s
    while time.monotonic() < deadline:
        line = scan_log(session, cmd["id"])
        if line is not None:
            return line
        time.sleep(3)
    return {"bridge": "wait-timeout", "id": cmd["id"]}


def parse_opts(rest: list[str], flags: dict) -> tuple[dict, list[str], str | None]:
    opts, out, i = {}, [], 0
    while i < len(rest):
        tok = rest[i]
        if tok in flags:
            if i + 1 >= len(rest):
                return opts, out, f"{tok} needs a value"
            try:
                opts[flags[tok]] = float(rest[i + 1]) if flags[tok] in ("timeout_s", "wait_s", "tail") else rest[i + 1]
            except ValueError:
                return opts, out, f"{tok} needs a number"
            i += 2
        else:
            out.append(tok)
            i += 1
    return opts, out, None


def main() -> int:
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 2
    cmd, rest = args[0], args[1:]
    session, _profile = lobby_session()

    if cmd == "status":
        block = lease._bridge_block(cr.colab, REPO)
        print(json.dumps({"bridge": block}, indent=1))
        return 0 if block else 1

    if cmd == "log":
        opts, _out, err = parse_opts(rest, {"--tail": "tail"})
        if err:
            print(f"colab-bridge: {err}", file=sys.stderr)
            return 2
        tail = int(opts.get("tail", 50))
        lines: list[str] = []
        if session:
            status = lease.bridge_status_read(cr.colab, REPO, session)
            if status is not None:
                last = 1
                try:
                    last = int(str(status.get("log_segment"))[7:13])
                except (TypeError, ValueError):
                    pass
                dest = lease.var_dir(REPO) / "bridge-client-dl.jsonl"
                for n in range(1, last + 1):
                    try:
                        r = cr.colab("download", "-s", session, f"{lease.BRIDGE_REMOTE}/log/bridge-{n:06d}.jsonl", str(dest), timeout=30)
                        if r.returncode == 0 and dest.exists():
                            lines.extend(dest.read_text(errors="replace").splitlines())
                    except Exception:  # noqa: BLE001
                        break
        if not lines:
            mirror = lease.var_dir(REPO) / "bridge-mirror.jsonl"
            if mirror.exists():
                lines = mirror.read_text(errors="replace").splitlines()
        for raw in lines[-tail:]:
            print(raw)
        return 0

    if session is None:
        print(json.dumps({"bridge": "no-lobby"}))
        return 2

    if cmd == "children":
        block = lease._bridge_block(cr.colab, REPO) or {}
        print(json.dumps({"children": block.get("children", [])}, indent=1))
        return 0

    if cmd == "ping":
        opts, _out, err = parse_opts(rest, {"--wait": "wait_s"})
        if err:
            print(f"colab-bridge: {err}", file=sys.stderr)
            return 2
        line = plant_and_wait(session, lease.bridge_command("ping"), opts.get("wait_s", 60.0))
        print(json.dumps(line, indent=1))
        return 0 if line.get("kind") == "pong" else 2

    if cmd == "cmd":
        opts, out, err = parse_opts(rest, {"--target": "target", "--timeout": "timeout_s", "--wait": "wait_s"})
        if err or not out:
            print(f"colab-bridge: {err or 'cmd needs a shell command'}", file=sys.stderr)
            return 2
        fields = {"target": opts.get("target", "self"), "cmd": " ".join(out)}
        if opts.get("timeout_s"):
            fields["timeout_s"] = opts["timeout_s"]
        line = plant_and_wait(session, lease.bridge_command("run", **fields), opts.get("wait_s", 180.0))
        print(json.dumps(line, indent=1))
        if line.get("kind") == "result":
            return int(line["rc"]) if isinstance(line.get("rc"), int) else 1
        return 2

    if cmd == "mint":
        opts, out, err = parse_opts(rest, {"--name": "name", "--wait": "wait_s"})
        if err or not out:
            print(f"colab-bridge: {err or 'mint needs a profile'}", file=sys.stderr)
            return 2
        fields = {"profile": out[0]}
        if opts.get("name"):
            fields["name"] = opts["name"]
        line = plant_and_wait(session, lease.bridge_command("mint", **fields), opts.get("wait_s", 300.0))
        print(json.dumps(line, indent=1))
        return 0 if line.get("kind") == "mint" else 2

    if cmd == "stop":
        opts, out, err = parse_opts(rest, {"--wait": "wait_s"})
        if err or not out:
            print(f"colab-bridge: {err or 'stop needs a child name'}", file=sys.stderr)
            return 2
        line = plant_and_wait(session, lease.bridge_command("stop", name=out[0]), opts.get("wait_s", 180.0))
        print(json.dumps(line, indent=1))
        return 0 if line.get("kind") == "stop" else 2

    print(__doc__)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
