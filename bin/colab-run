#!/usr/bin/env python3
"""Run a named job on Colab: sweep orphans, sync in, execute detached, poll,
pull results, stop the session on every exit path.

Usage: colab-run <job-name> [--resume RUN_ID] [--caller TAG] [--seed] [-- <job args>...]
Job manifest: jobs/<name>/job.json (JSON: repo code parses it, so not YAML).
--caller TAG (or the manifest's "caller" key, or $COLAB_CALLER)
attributes the run to its thread: it rides the lease acquire and
is stamped on the run record.
The CLI is resolved via $COLAB_BIN (tests point this at a fake), else the
uv tool venv (~/.local/share/uv/tools/google-colab-cli/bin/colab), else
PATH, else ~/.local/bin/colab. The CLI is deliberately NOT installed on
PATH (no global shim): this funnel is the only sanctioned access, and a
bare `colab` in an agent shell is a contract breach, not a shortcut.
"""

import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RUNS = REPO / "results" / "runs"
TOKEN = Path.home() / ".config" / "colab-cli" / "token.json"

import importlib.util

_spec_l = importlib.util.spec_from_file_location("lease", REPO / "sync" / "lease.py")
lease = importlib.util.module_from_spec(_spec_l)
_spec_l.loader.exec_module(lease)

_spec_r = importlib.util.spec_from_file_location("repo_registry", REPO / "sync" / "repo_registry.py")
repo_registry = importlib.util.module_from_spec(_spec_r)
_spec_r.loader.exec_module(repo_registry)

_spec_t = importlib.util.spec_from_file_location("transfer", REPO / "sync" / "transfer.py")
transfer = importlib.util.module_from_spec(_spec_t)
_spec_t.loader.exec_module(transfer)


def colab_bin() -> str:
    env_bin = os.environ.get("COLAB_BIN")
    if env_bin:
        return env_bin
    venv_bin = Path.home() / ".local" / "share" / "uv" / "tools" / "google-colab-cli" / "bin" / "colab"
    if venv_bin.exists():
        return str(venv_bin)
    return shutil.which("colab") or str(Path.home() / ".local" / "bin" / "colab")


def colab_env() -> dict:
    env = dict(os.environ)
    for key in ("NO_PROXY", "no_proxy"):
        suffix = "google.com,googleapis.com,googleusercontent.com,colab.dev"
        env[key] = f"{env[key]},{suffix}" if env.get(key) else suffix
    return env


AUTH_PROMPT = "Enter the authorization code"
AUTH_RC = 3
TOKEN_MIN_REFRESH_LEN = 20


def _token_bytes() -> bytes | None:
    try:
        return TOKEN.read_bytes()
    except OSError:
        return None


def _token_valid(data: bytes | None) -> bool:
    """A stored credential is valid when it parses as JSON and carries
    a refresh_token of plausible length. The interactive flow's stub
    (a lone refresh_token key, 15 chars) fails this, as does any
    truncated or non-JSON write. Contents are never printed."""
    if not data:
        return False
    try:
        parsed = json.loads(data)
    except (ValueError, UnicodeDecodeError):
        return False
    if not isinstance(parsed, dict):
        return False
    rt = parsed.get("refresh_token")
    return isinstance(rt, str) and len(rt) >= TOKEN_MIN_REFRESH_LEN


def _atomic_write_token(data: bytes) -> None:
    """Write the token via a .tmp sibling + rename, so no reader ever
    sees a partial credential and an interrupted write cannot destroy
    the live file (owner ruling, 2026-11-01: token writes are atomic
    at every seam)."""
    tmp = TOKEN.with_name(TOKEN.name + ".tmp")
    tmp.write_bytes(data)
    os.chmod(tmp, 0o600)
    os.replace(tmp, TOKEN)


def _note_auth_required(reason: str) -> None:
    try:
        var = lease.var_dir(REPO)
        var.mkdir(parents=True, exist_ok=True)
        (var / "auth-required.json").write_text(json.dumps({"noted_at": now(), "reason": reason}, indent=2))
    except OSError:
        pass


def _clear_auth_required() -> None:
    try:
        (lease.var_dir(REPO) / "auth-required.json").unlink(missing_ok=True)
    except OSError:
        pass


def _auth_blocked(cmd: list[str], reason: str) -> subprocess.CompletedProcess:
    _note_auth_required(reason)
    return subprocess.CompletedProcess(args=cmd, returncode=AUTH_RC, stdout="", stderr=f"colab auth required: {reason}")


def colab(*args: str, timeout: int = 18000) -> subprocess.CompletedProcess:
    """The one funnel for every automated Colab CLI call, guarded so a
    dead credential can never again masquerade as data (2026-11-01: a
    failed token refresh dropped the CLI into its interactive login
    flow, which overwrote the stored token with a stub and printed the
    auth prompt where callers expected a session list / usage text —
    the prompt read as "session absent" and a live lease's record was
    deleted under it). The guard:
    - never invokes the CLI when the stored token is missing/invalid;
    - snapshots the token before the call and restores it atomically
      if the call leaves it invalid (the flow writes its stub BEFORE
      prompting, so this also covers a call that times out blocked on
      the prompt);
    - turns any call whose output carries the auth prompt into an
      auth-required result (rc 3, empty stdout), so downstream reads
      see "unknown", never junk data.
    Inert under COLAB_BIN: the test fakes are not credential flows."""
    cmd = [colab_bin(), "--auth", "oauth2", *args]
    if os.environ.get("COLAB_BIN"):
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=colab_env())
    snapshot = _token_bytes()
    if not _token_valid(snapshot):
        return _auth_blocked(cmd, "stored token missing or invalid; re-authorization required (no CLI call made)")
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=colab_env(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        if not _token_valid(_token_bytes()):
            _atomic_write_token(snapshot)
            _note_auth_required("CLI call timed out after overwriting the token; snapshot restored")
        raise
    if AUTH_PROMPT in (result.stdout + result.stderr):
        if not _token_valid(_token_bytes()):
            _atomic_write_token(snapshot)
        return _auth_blocked(cmd, "CLI entered its interactive login flow")
    if not _token_valid(_token_bytes()):
        _atomic_write_token(snapshot)
        return _auth_blocked(cmd, "CLI call overwrote the stored token; snapshot restored")
    if result.returncode == 0:
        _clear_auth_required()
    return result


def mirror(op: str) -> None:
    subprocess.run([sys.executable, str(REPO / "ops" / "mirror_transient.py"), op], capture_output=True)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def save_record(rec: dict) -> None:
    RUNS.mkdir(parents=True, exist_ok=True)
    (RUNS / f"{rec['run_id']}.json").write_text(json.dumps(rec, indent=2))


def orphan_sweep() -> list[dict]:
    """Reconcile non-terminal run records against live sessions."""
    findings = []
    if not RUNS.exists():
        return findings
    live = colab("sessions", timeout=120).stdout if TOKEN.exists() or os.environ.get("COLAB_BIN") else ""
    for f in sorted(RUNS.glob("*.json")):
        rec = json.loads(f.read_text())
        if rec["state"] in ("running", "polling") and rec.get("session") not in live:
            rec["state"] = "orphaned"
            rec["orphan_noted_at"] = now()
            save_record(rec)
            findings.append({"run_id": rec["run_id"], "job": rec["job"], "action": "marked orphaned; relaunch with --resume RUN_ID to continue from its remote run-id"})
    return findings


def main() -> int:
    args = sys.argv[1:]
    # Flags travel in pairs and may sit on either side of the job
    # name — extract them first and take the first remaining token
    # as the job. (Job-first-only parsing read a leading --caller
    # as a job name; it bit a consumer following shorthand in a
    # message, 2026-11-05.)
    resume = caller_flag = None
    seed_flag = False
    extra_args = []
    positional = []
    i = 0
    while i < len(args):
        if args[i] == "--":
            # Everything after -- is the job's own argv (the repo
            # selection seam: env-build -- --repo <id> reaches
            # env_build.sh without a manifest per repo).
            extra_args = args[i + 1:]
            break
        if args[i] == "--seed":
            seed_flag = True
            i += 1
        elif args[i] == "--resume" and i + 1 < len(args):
            resume = args[i + 1]
            i += 2
        elif args[i] == "--caller" and i + 1 < len(args):
            caller_flag = args[i + 1]
            i += 2
        else:
            positional.append(args[i])
            i += 1
    if not positional:
        print("usage: colab-run <job-name> [--resume RUN_ID] [--caller TAG] [--seed] [-- <job args>...]", file=sys.stderr)
        return 2
    job_name = positional[0]
    manifest_path = REPO / "jobs" / job_name / "job.json"
    if not manifest_path.exists():
        print(f"no job manifest at {manifest_path}", file=sys.stderr)
        return 2
    job = json.loads(manifest_path.read_text())
    # Caller claim: flag over the manifest's caller key over
    # $COLAB_CALLER; a presented but unregistered claim is refused
    # at claim time, before anything starts.
    claim_raw = caller_flag if caller_flag is not None else job.get("caller")
    claim_err = lease.caller_claim_error(REPO, flag=claim_raw, env=os.environ.get("COLAB_CALLER"))
    if claim_err:
        print(f"colab-run: {claim_err}", file=sys.stderr)
        return 2
    caller = lease.resolve_caller(REPO, flag=claim_raw, env=os.environ.get("COLAB_CALLER"))
    if not TOKEN.exists() and not os.environ.get("COLAB_BIN"):
        print("colab-run: STAGED — no colab login yet. Run ops/bootstrap_local.sh, then the one-time login (see README).", file=sys.stderr)
        return 2

    mirror("restore")
    findings = orphan_sweep()
    for f in findings:
        # Findings ride stderr: stdout is the run's JSON result,
        # and a sweep line ahead of it breaks every consumer that
        # parses the result (hit live 2026-11-05, again in the
        # co-tenancy tests 2026-11-06).
        print(f"orphan sweep: {f['run_id']} ({f['job']}) — {f['action']}", file=sys.stderr)

    # A manifest may name its shape; otherwise the config's
    # default_shape is the only fallback — no shape is hardcoded
    # here, and an unresolvable shape fails loudly.
    shape_id = job.get("shape") or lease.default_shape(REPO)
    shapes = lease.catalog_shapes(REPO, colab)
    if not shape_id or shape_id not in shapes:
        print(f"colab-run: job {job_name} names no usable shape (manifest shape or config default_shape required)", file=sys.stderr)
        return 2
    shape = shapes[shape_id]
    run_id = resume or f"{job_name}-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}"
    rec = None
    if resume:
        # A resume continues the run on disk: its launch facts
        # (started_at above all) are the run's history and are
        # never re-stamped — the resume adds its own facts.
        # (2026-11-06: a resumed hold came back stamped with the
        # resume moment, erasing its launch time.)
        prior = RUNS / f"{run_id}.json"
        if prior.exists():
            rec = json.loads(prior.read_text())
            rec.update(state="starting", resumed=True, resumed_at=now())
    if rec is None:
        rec = {"run_id": run_id, "job": job_name, "shape": shape_id, "state": "starting", "started_at": now(), "resumed": bool(resume)}
    if caller:
        rec["caller"] = caller
    save_record(rec)
    # Bundle seed (--seed — env-build's private-repo route): the
    # job's target repo reaches the VM as a snapshot bundle, never
    # as a VM-side clone. A private repo's plain HTTPS clone
    # cannot authenticate on the VM (no credential lives there by
    # design), so before launch the runner builds the bundle from
    # the registry entry's local checkout (the same builder
    # colab-check ships), uploads it, and seeds the dest from it
    # (sync/apply_bundle_remote.py's seed mode); the job then runs
    # with --skip-clone. Built here, before any session is held,
    # so a local build failure holds nothing.
    seed_ctx = None
    if seed_flag and not resume:
        def _extra(flag):
            return extra_args[extra_args.index(flag) + 1] if flag in extra_args and extra_args.index(flag) + 1 < len(extra_args) else None
        try:
            registry = repo_registry.load_local_registry(REPO)
            seed_repo_id, seed_entry = repo_registry.get_entry(registry, _extra("--repo"))
            seed_dest = repo_registry.variant_dest(seed_entry, _extra("--variant"))
        except ValueError as exc:
            rec.update(state="failed", error=f"bundle seed: {exc}")
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
            return 1
        bundle_env = dict(os.environ)
        bundle_env["COLAB_REPO_SRC"] = str(Path(os.path.expanduser(seed_entry["local_path"])))
        bundle = subprocess.run(["bash", str(REPO / "sync" / "make_snapshot_bundle.sh")], capture_output=True, text=True, env=bundle_env)
        if bundle.returncode != 0:
            rec.update(state="failed", error=f"bundle seed: snapshot build failed: {bundle.stderr[-300:]}")
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
            return 1
        seed_manifest = json.loads(bundle.stdout)
        seed_ctx = {"repo": seed_repo_id, "dest": seed_dest, "clone_url": seed_entry["clone_url"], "bundle_path": Path(seed_manifest["bundle"]), "manifest": seed_manifest}
        rec["bundle_seed"] = {"repo": seed_repo_id, "dest": seed_dest, "sha256": seed_manifest["sha256"], "bytes": seed_manifest["bytes"], "snapshot_commit": seed_manifest["snapshot_commit"], "tree": seed_manifest["tree"]}
        save_record(rec)
    usage_before = colab("usage", timeout=120).stdout.strip()
    # Lease model (sync/lease.py): adopt-or-acquire the shared session and
    # leave it up at the end; the reaper owns its lifecycle. With the lease
    # disabled in config, fall back to the original per-job session.
    use_lease = bool(lease.load_config(REPO).get("enabled"))
    session = run_id  # the lease-disabled fallback's per-run session
    if use_lease:
        got = lease.acquire(colab, REPO, shape_id, via="runner", caller=caller)
        if got["action"] in ("refused-budget", "create-failed", "shape-refused", "shape-mismatch", "caller-start-refused", "unknown-shape"):
            rec.update(state="failed", error=json.dumps(got)[:300])
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "lease": got}, indent=2))
            return 1
        rec["lease_action"] = got["action"]
        # The lease's session is whatever the acquire created or
        # adopted — a generated name, never a configured one.
        session = got["record"]["session"]
        rec["session"] = session
        lease.touch_job(REPO, run_id)
        save_record(rec)
    if not use_lease:
        rec["session"] = session
        save_record(rec)
        # Session shape gate for the fallback's own `new` below (the
        # lease path is gated inside acquire): a job run is an agent
        # actor unless the env claim says otherwise. A refusal fails
        # the run before any session is created.
        refusal = lease.enforce_session_admission(REPO, shape_id, via="runner", shape=shape, seam="runner", caller=caller)
        if refusal is not None:
            rec.update(state="failed", error=json.dumps(refusal)[:300])
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "lease": refusal}, indent=2))
            return 1
    try:
        if not use_lease:
            new_args = ["new", "-s", session] + lease._session_shape_args(shape)
            r = colab(*new_args, timeout=600)
            if r.returncode != 0 and "already" not in (r.stdout + r.stderr):
                rec.update(state="failed", error=(r.stderr or r.stdout).strip()[-300:])
                save_record(rec)
                return 1
        script = REPO / job["script"]
        colab("upload", "-s", session, str(script), f"/content/{script.name}", timeout=600)
        # Manifest-declared extra uploads land at /content/<name>
        # before launch: a shell_job payload names its script in
        # args (--script /content/env_build.sh) and the registry it
        # reads (/content/repos.json), and neither is the runner
        # script itself. Until this loop existed nothing uploaded
        # them, so env-build's shell_job refused in its first
        # second (2026-11-05) — a declared upload missing locally
        # fails the run here, never launches a job that cannot run.
        for extra in job.get("uploads", []):
            src = REPO / extra
            if not src.is_file():
                rec.update(state="failed", error=f"manifest upload missing locally: {extra}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            colab("upload", "-s", session, str(src), f"/content/{src.name}", timeout=600)
        seeded = False
        if seed_ctx is not None:
            # Move the bundle (chunked — it can exceed the
            # single-file ceiling), its manifest, and the apply
            # script, then seed the dest on the VM and verify the
            # manifest's tree in the seed's own output before any
            # launch: a seed that did not land is a failed run,
            # never a job launched against a missing tree.
            up = transfer.chunked_upload(session, seed_ctx["bundle_path"], seed_ctx["bundle_path"].name)
            if not up["ok"]:
                rec.update(state="failed", error=f"bundle seed: chunked upload failed: {json.dumps(up)[:300]}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            colab("upload", "-s", session, str(seed_ctx["bundle_path"]) + ".manifest.json", f"/content/{seed_ctx['bundle_path'].name}.manifest.json", timeout=300)
            colab("upload", "-s", session, str(REPO / "sync" / "apply_bundle_remote.py"), "/content/apply_bundle_remote.py", timeout=300)
            seed_remote = REPO / "var" / f"seed-{run_id}.py"
            seed_remote.write_text(
                "import subprocess\n"
                f"r = subprocess.run(['python3','apply_bundle_remote.py','{seed_ctx['bundle_path'].name}','{seed_ctx['dest']}','--origin-url','{seed_ctx['clone_url']}'], capture_output=True, text=True)\n"
                "print(r.stdout); print(r.stderr[-500:])\n"
            )
            sr = colab("exec", "-s", session, "--timeout", "1800", "-f", str(seed_remote), timeout=1900)
            if '"applied": true' not in sr.stdout or seed_ctx["manifest"]["tree"] not in sr.stdout:
                rec.update(state="failed", error=f"bundle seed: seed did not verify: {sr.stdout.strip()[-300:]}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            seeded = True
        # Relative to the session working dir (/content on a real Colab VM;
        # the fake CLI's sandbox root under test) so the same code runs both.
        # Per-run: a fixed dir leaks the previous run's heartbeat tail,
        # checkpoint, and outputs into this run's completion check.
        remote_out = f"{job_name}-out-{run_id}"
        rec.update(state="running", remote_out=remote_out, extra_args=extra_args)
        save_record(rec)
        # Detached launch (default pending the kill-matrix verdict): a short
        # exec starts the job under nohup; the CLI is never the job's lifeline.
        job_args = "".join(f",'{a}'" for a in list(job.get("args", [])) + (["--skip-clone"] if seeded else []) + extra_args)
        launch = (
            f"import subprocess; subprocess.Popen(['nohup','python3','{script.name}',"
            f"'--out','{remote_out}'{job_args}], stdout=open('{remote_out}.log','w'), stderr=subprocess.STDOUT, start_new_session=True)"
        )
        launcher = REPO / "var" / f"launch-{run_id}.py"
        launcher.parent.mkdir(parents=True, exist_ok=True)
        launcher.write_text(launch + "\nprint('launched')\n")
        colab("exec", "-s", session, "--timeout", "120", "-f", str(launcher), timeout=300)
        rec["state"] = "polling"
        save_record(rec)
        reader = REPO / "var" / f"read-{run_id}.py"
        reader.write_text(
            "import json, subprocess\n"
            "from pathlib import Path\n"
            f"d = Path('{remote_out}')\n"
            "ck = d / 'checkpoint.json'\n"
            "log = d / 'heartbeat.log'\n"
            f"jlog = Path('{remote_out}.log')\n"
            "out = {'checkpoint': json.loads(ck.read_text()) if ck.exists() else None,\n"
            "       'heartbeat_tail': log.read_text().strip().split('\\n')[-3:] if log.exists() else [],\n"
            f"       'job_log_tail': jlog.read_text(errors='replace').strip().split('\\n')[-5:] if jlog.exists() else [],\n"
            f"       'job_pids': subprocess.run(['pgrep','-f','{remote_out}'], capture_output=True, text=True).stdout.split(),\n"
            "       'heartbeat_pids': subprocess.run(['pgrep','-f','heartbeat_job'], capture_output=True, text=True).stdout.split()}\n"
            "print(json.dumps(out))\n"
        )
        deadline = time.time() + job.get("timeout", 18000)
        cadence = job.get("checkpoint_pull_seconds", 300)
        # A checkpoint poll that outlives its subprocess timeout
        # is a failed poll, not a dead poller (2026-11-06: an
        # uncaught TimeoutExpired killed the poller mid-run and
        # stranded the record at polling while the payload
        # completed). The timeout is env-tunable for the same
        # reason the cadence is a manifest value: tests shrink it.
        poll_timeout = int(os.environ.get("COLAB_RUN_POLL_TIMEOUT_S", "300"))
        state = {}
        while time.time() < deadline:
            time.sleep(cadence)
            try:
                chk = colab("exec", "-s", session, "--timeout", "120", "-f", str(reader), timeout=poll_timeout)
            except subprocess.TimeoutExpired:
                rec["last_poll_error"] = f"checkpoint poll timed out at {now()}"
                save_record(rec)
                continue
            try:
                state = json.loads(chk.stdout[chk.stdout.index("{"):])
            except (ValueError, json.JSONDecodeError):
                continue
            done_units = (state.get("checkpoint") or {}).get("completed_units", 0)
            rec["last_checkpoint_units"] = done_units
            save_record(rec)
            log = state.get("heartbeat_tail") or []
            if any("complete" in ln for ln in log) or (job.get("units") and done_units >= job["units"]):
                break
            if not state.get("job_pids") and state.get("job_log_tail"):
                # The launched process is gone and its launcher log
                # is all that exists: the job died before producing
                # a checkpoint — shell_job refusing a never-uploaded
                # --script file is the proven case (2026-11-05: its
                # one-line refusal sat in this log while the poller
                # polled an empty out dir through two timeouts,
                # ~40 min of apparent progress). A completed job
                # always trips the completion check above in the
                # same poll, so reaching here means death, not
                # completion: fail with the log tail in hand.
                tail = "\n".join(state["job_log_tail"])
                rec.update(state="failed", error=(f"job exited before completing; remote log tail: {tail}")[-500:])
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
        # Pull expected outputs and verify by the job's own unit hashes.
        pulled = []
        for name in job.get("outputs", []):
            dest = REPO / "results" / run_id / name
            dest.parent.mkdir(parents=True, exist_ok=True)
            colab("download", "-s", session, f"/content/{remote_out}/{name}", str(dest), timeout=600)
            if dest.exists():
                pulled.append({"path": name, "bytes": dest.stat().st_size, "sha256": hashlib.sha256(dest.read_bytes()).hexdigest()})
        exit_code = (state.get("checkpoint") or {}).get("exit_code")
        if exit_code not in (None, 0):
            # The payload ran and stamped its own failure in the
            # checkpoint (shell_job carries the script's exit code):
            # the outputs above are pulled regardless — reports and
            # verdicts land locally either way — but the run record
            # tells the truth about the outcome. (2026-11-05: a
            # job-zero build whose init_venv.py failed recorded
            # "complete" with a clean-looking pull; only a human
            # reading the pulled report saw assertions_passed:
            # false.) Jobs whose checkpoints carry no exit_code are
            # unaffected.
            rec.update(state="failed", finished_at=now(), error=f"job payload exited {exit_code}", pulled=pulled, usage_before=usage_before, usage_after=colab("usage", timeout=120).stdout.strip())
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"], "pulled": pulled}, indent=2))
            return 1
        rec.update(state="complete", finished_at=now(), pulled=pulled, usage_before=usage_before, usage_after=colab("usage", timeout=120).stdout.strip())
        save_record(rec)
        print(json.dumps({"run_id": run_id, "state": "complete", "pulled": pulled}, indent=2))
        return 0
    finally:
        if use_lease:
            lease.finish_job(REPO, run_id)
        else:
            colab("stop", "-s", session, timeout=120)
        mirror("capture")


if __name__ == "__main__":
    raise SystemExit(main())
