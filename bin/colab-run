#!/usr/bin/env python3
"""Run a named job on Colab: sync in, execute detached, poll,
pull results, stop the session on every exit path.

Usage: colab-run <job-name> [--resume RUN_ID] [--caller TAG] [--seed] [--detach] [-- <job args>...]
       colab-run --poll RUN_ID | --wait RUN_ID [--max SECONDS] | --sweep
Job manifest: jobs/<name>/job.json (JSON: repo code parses it, so not YAML).
--caller TAG (or the manifest's "caller" key, or $COLAB_CALLER)
attributes the run to its thread: it rides the lease acquire and
is stamped on the run record.
--detach launches exactly as the foreground form and returns at
once with {run_id, session, state}: the run's record then advances
only when something reconciles it — --poll (one bounded reconcile:
reader exec + pull + record update; exit 0 complete, 1 failed or
orphaned, 3 still running), a later launch's --resume, or --sweep.
--wait polls the LOCAL record only (zero channel use) until the
run is terminal or --max seconds pass (exit 0 complete, 1 failed
or orphaned, 3 still running at the bound). --sweep reconciles
every non-terminal record against the live list. A launched run's
terminal transition appends exactly one run-terminal event to
var/ui-outbox.jsonl.
The CLI funnel — resolution ($COLAB_BIN, else the uv tool venv,
else PATH, else ~/.local/bin/colab), the NO_PROXY environment, and
the guarded invocation — lives in sync/cli.py, the one module every
consumer loads. This module re-exports its colab / colab_bin /
colab_env / TOKEN under their existing names.
"""

import hashlib
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RUNS = REPO / "results" / "runs"

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _load

cli = _load.sync("cli")
lease = _load.sync("lease")
repo_registry = _load.sync("repo_registry")
transfer = _load.sync("transfer")

# The funnel, re-exported under the names this module's consumers
# (bin/colab-lease & friends historically, the test suites) use.
colab = cli.colab
colab_bin = cli.colab_bin
colab_env = cli.colab_env
TOKEN = cli.TOKEN


def mirror(op: str) -> None:
    subprocess.run([sys.executable, str(REPO / "ops" / "mirror_transient.py"), op], capture_output=True)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def save_record(rec: dict) -> None:
    RUNS.mkdir(parents=True, exist_ok=True)
    (RUNS / f"{rec['run_id']}.json").write_text(json.dumps(rec, indent=2))


TERMINAL_STATES = ("complete", "failed", "orphaned")

# E11: consecutive poll failures before the poller classifies the
# session. The classification itself uses the reap pass's reduced
# read budget (2 attempts x 45 s), so one classification costs a
# bounded ~90 s worst case, never the standard ~370 s.
POLL_FAILURE_BOUND = 3

# E6: the file channel's measured single-file reliability ceiling
# (AGENTS.md, file channel) — a declared output larger than this
# moves by the chunked route, never as one download.
SINGLE_FILE_CEILING_BYTES = 50 * 1024 * 1024


def load_run_record(run_id: str) -> dict | None:
    try:
        rec = json.loads((RUNS / f"{run_id}.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    return rec if isinstance(rec, dict) else None


# Pre-launch uploads above this size move through the chunked
# transfer (which verifies the whole-file hash) instead of the
# plain upload: the single-file ceiling the fs tools enforce.
UPLOAD_CHUNK_THRESHOLD_BYTES = 50 * 1024 * 1024


def upload_one(session: str, src: Path, dest_name: str, tag: str) -> str | None:
    """One pre-launch upload, verified before the job starts.
    A failed or short transfer is an error HERE — never a
    missing file discovered inside the job later (2026-11-08:
    a ~100 MB snapshot bundle's plain upload failed with its
    return code unchecked and the run proceeded without it).
    Large files move chunked (hash-verified by the transfer);
    smaller files move plain and are verified by remote size
    through a probe exec in the session's working directory,
    the reader's own model. Returns an error string, or None
    on a verified landing."""
    if src.stat().st_size > UPLOAD_CHUNK_THRESHOLD_BYTES:
        up = transfer.chunked_upload(session, src, dest_name)
        if not up["ok"]:
            return f"chunked upload failed: {json.dumps(up)[:300]}"
        return None
    r = colab("upload", "-s", session, str(src), f"/content/{dest_name}", timeout=600)
    if r.returncode != 0:
        return f"upload failed (rc {r.returncode}): {(r.stderr or r.stdout).strip()[-300:]}"
    probe = REPO / "var" / f"upload-probe-{tag}.py"
    probe.parent.mkdir(parents=True, exist_ok=True)
    probe.write_text(f"import os, json\np = {dest_name!r}\nprint(json.dumps({{'size': os.path.getsize(p) if os.path.exists(p) else None}}))\n")
    pr = colab("exec", "-s", session, "--timeout", "120", "-f", str(probe), timeout=300)
    try:
        size = json.loads(pr.stdout[pr.stdout.index("{"):])["size"]
    except (ValueError, KeyError):
        return f"upload verify unreadable for {dest_name}: {pr.stdout.strip()[-200:]}"
    if size != src.stat().st_size:
        return f"upload verify: {dest_name} landed at {size} bytes, expected {src.stat().st_size}"
    return None


def outbox_path() -> Path:
    # The UI outbox lives in the runner var dir (the panel's own
    # var_dir() convention: $COLAB_RUNNER_VAR, else the repo's var).
    return Path(os.environ.get("COLAB_RUNNER_VAR", REPO / "var")) / "ui-outbox.jsonl"


def emit_terminal_event(rec: dict) -> bool:
    """Append the run's one run-terminal event to the UI outbox.

    The lease core already appends its own kinds there (the
    lease-extended chain the adoption census reads is the
    precedent); a run's terminal transition is the runner's kind.
    Guarded on the record: terminal_event_state stamps the state
    the event announced, so a second terminal observation of the
    same run (a --poll after the foreground poller finished, a
    sweep after a finalize) never double-announces — while a
    resumed run, whose resume clears the stamp, announces its new
    terminal state afresh. Best-effort: a failed append stamps
    nothing, so a later transition may retry it. Returns True
    when it appended."""
    if rec.get("terminal_event_state") == rec.get("state"):
        return False
    path = outbox_path()
    seq = 0
    try:
        lines = path.read_text().splitlines()
        for line in reversed(lines):
            if line.strip():
                try:
                    seq = int(json.loads(line).get("seq", 0))
                except (ValueError, json.JSONDecodeError):
                    seq = len(lines)
                break
    except OSError:
        seq = 0
    event = {
        "seq": seq + 1,
        "ts": now(),
        "kind": "run-terminal",
        "detail": {"run_id": rec["run_id"], "job": rec.get("job"), "caller": rec.get("caller"), "state": rec["state"], "session": rec.get("session")},
    }
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as fh:
            fh.write(json.dumps(event) + "\n")
    except OSError:
        return False
    rec["terminal_event_state"] = rec["state"]
    rec["terminal_event_at"] = event["ts"]
    return True


def mark_terminal(rec: dict, state: str, **fields) -> None:
    """Move a launched run to a terminal state: record update,
    save, and its exactly-one run-terminal outbox event."""
    rec.update(state=state, **fields)
    save_record(rec)
    if emit_terminal_event(rec):
        save_record(rec)


def orphan_sweep() -> tuple[list[dict], bool]:
    """Reconcile non-terminal run records against live sessions.

    Membership is exact-name, through the lease core's live-list
    parser (lease.live_sessions) — never substring on raw stdout:
    a name that textually collides with a live one must not read
    as alive, and a partial list must not read as a census. An
    unreadable list (None) reconciles nothing — the session_state
    rule, that no caller may act on a list it could not read. A
    torn record is skipped, never fatal: one damaged file must
    not block the reconcile of every other run (it blocked every
    runner entry in the 2026-11-08 flap). The sweep runs on the
    reconcile cadences (--poll, --sweep), never on the launch
    path. Returns (findings, live_list_readable)."""
    findings = []
    if not RUNS.exists():
        return findings, True
    live = lease.live_sessions(colab, REPO)
    if live is None:
        return findings, False
    live_names = {entry["session"] for entry in live}
    for f in sorted(RUNS.glob("*.json")):
        try:
            rec = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if rec.get("state") in ("running", "polling") and rec.get("session") not in live_names:
            rec["state"] = "orphaned"
            rec["orphan_noted_at"] = now()
            save_record(rec)
            if emit_terminal_event(rec):
                save_record(rec)
            findings.append({"run_id": rec["run_id"], "job": rec["job"], "action": "marked orphaned; relaunch with --resume RUN_ID to continue from its remote run-id"})
    return findings, True


def write_reader(run_id: str, remote_out: str, outputs: list) -> Path:
    """The per-run reader payload: checkpoint, heartbeat tail,
    launcher log tail, payload pids — plus each declared output's
    size/mtime, the change evidence pull_outputs skips on (E6)."""
    reader = REPO / "var" / f"read-{run_id}.py"
    reader.parent.mkdir(parents=True, exist_ok=True)
    reader.write_text(
        "import json, subprocess\n"
        "from pathlib import Path\n"
        f"d = Path({remote_out!r})\n"
        "ck = d / 'checkpoint.json'\n"
        "log = d / 'heartbeat.log'\n"
        f"jlog = Path({remote_out + '.log'!r})\n"
        f"names = {json.dumps(outputs)}\n"
        "def _stat(p):\n"
        "    try:\n"
        "        s = p.stat()\n"
        "        return {'size': s.st_size, 'mtime': s.st_mtime}\n"
        "    except OSError:\n"
        "        return None\n"
        "def _ecode(p):\n"
        "    try:\n"
        "        return int(p.read_text().strip())\n"
        "    except (OSError, ValueError):\n"
        "        return None\n"
        f"ecode = Path({remote_out + '.exit-code'!r})\n"
        "out = {'checkpoint': json.loads(ck.read_text()) if ck.exists() else None,\n"
        "       'heartbeat_tail': log.read_text().strip().split('\\n')[-3:] if log.exists() else [],\n"
        "       'job_log_tail': jlog.read_text(errors='replace').strip().split('\\n')[-5:] if jlog.exists() else [],\n"
        "       'exit_stamp': _ecode(ecode),\n"
        f"       'job_pids': subprocess.run(['pgrep','-f',{remote_out!r}], capture_output=True, text=True).stdout.split(),\n"
        "       'heartbeat_pids': subprocess.run(['pgrep','-f','heartbeat_job'], capture_output=True, text=True).stdout.split(),\n"
        "       'outputs': {n: _stat(d / n) for n in names}}\n"
        "print(json.dumps(out))\n"
    )
    return reader


def read_reader(session: str, reader: Path, poll_timeout: int) -> tuple[dict | None, str | None]:
    """One bounded reader exec. Returns (state, None) on a
    readable poll, (None, error) on a failed one — a subprocess
    timeout and an unparseable answer are the same class here:
    this poll produced no evidence (E11 counts both)."""
    try:
        chk = colab("exec", "-s", session, "--timeout", "120", "-f", str(reader), timeout=poll_timeout)
    except subprocess.TimeoutExpired:
        return None, f"checkpoint poll timed out at {now()}"
    try:
        return json.loads(chk.stdout[chk.stdout.index("{"):]), None
    except (ValueError, json.JSONDecodeError):
        return None, f"checkpoint poll returned no readable state at {now()}"


def register_poll_failure(rec: dict, session: str, error: str) -> str:
    """Count one consecutive poll failure (E11) and, at the
    bound, classify the session at the reap pass's reduced read
    budget. Confirmed absent fails the run fast — the payload
    died with its session, and the record carries the resume
    note. Alive means the reader, not the session, is flaky: the
    count resets. Unknown never fails a run; the count stands,
    so the next failure classifies again. Returns "failed" when
    this failure ended the run, else "continue"."""
    rec["last_poll_error"] = error
    rec["poll_failures"] = int(rec.get("poll_failures") or 0) + 1
    save_record(rec)
    if rec["poll_failures"] < POLL_FAILURE_BOUND:
        return "continue"
    diag: dict = {}
    verdict = lease.session_state(colab, session, diag, attempts=lease._REAP_READ_ATTEMPTS, timeout=lease._REAP_READ_TIMEOUT_S)
    rec["last_classification"] = {"verdict": verdict, "at": now(), **diag}
    if verdict == "absent":
        mark_terminal(
            rec,
            "failed",
            error=(
                f"session {session} confirmed absent after {rec['poll_failures']} consecutive poll failures; "
                f"the payload died with its session — relaunch with --resume {rec['run_id']} to continue from its remote run-id"
            ),
        )
        return "failed"
    if verdict == "alive":
        rec["poll_failures"] = 0
    save_record(rec)
    return "continue"


def pull_outputs(rec: dict, job: dict, session: str, remote_out: str, reader_state: dict | None = None) -> list:
    """Download the declared outputs to results/<run_id>/.

    Runs at every checkpoint cadence while the job runs — the
    manifest's checkpoint_pull_seconds is a pull cadence, not
    only a poll cadence (2026-11-07: the venue relay starved
    because outputs landed only at completion, so a 12 h job's
    log never reached the local reader waiting on it) — and once
    more after the loop as the authoritative final pull. A failed
    or timed-out download is noted on the record and never breaks
    the poll loop; a missing remote file (the job has not written
    it yet) simply pulls nothing.

    Change detection (E6): the reader reports each output's
    size/mtime; an output whose stat still equals the stat its
    last successful pull recorded is skipped — a long job's
    stable outputs are no longer re-moved whole at every cadence.
    An output above the single-file ceiling moves via
    transfer.chunked_download (32 MB parts, whole-file SHA-256
    verified) instead of one plain download.

    Entries accumulate on the record (rec["pulled"], one per
    path, latest pull winning) and the accumulated list is what
    this returns: with the skip above, a per-call list would
    leave the terminal record reporting only the outputs the
    final call happened to move — usually none.

    Shrink guard: every pull lands on a staging sibling first,
    and when the new content would replace a non-empty held
    file with FEWER bytes, the held copy is rotated aside under
    a stamped sibling name before the staging file moves in,
    with the rotation noted on the pull entry and the record.
    A remote output that restarts smaller must not silently
    erase the history already pulled (2026-11-08: after a
    wrapper resume, the venue keeper's pulled log shrank to its
    first line and the accumulated record was gone — the
    forensic read had to fall back to the venue-side lease
    log). Equal-or-growing pulls keep the single-file behavior.
    """
    pulled_now = []
    stats = (reader_state or {}).get("outputs") or {}
    stored = rec.setdefault("output_stats", {})
    for name in job.get("outputs", []):
        dest = REPO / "results" / rec["run_id"] / name
        stat = stats.get(name)
        if stat is not None and stored.get(name) == stat and dest.exists():
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        staging = dest.with_name(dest.name + ".pulling")
        entry = None
        if stat is not None and stat["size"] > SINGLE_FILE_CEILING_BYTES:
            res = transfer.chunked_download(session, f"{remote_out}/{name}", staging)
            if not res.get("ok"):
                rec["last_pull_error"] = f"chunked pull of {name} failed at {now()}: {res.get('stage', 'unknown stage')}"
                staging.unlink(missing_ok=True)
                continue
            entry = {"path": name, "bytes": res["bytes"], "sha256": res["sha256"], "route": "chunked"}
        else:
            try:
                colab("download", "-s", session, f"/content/{remote_out}/{name}", str(staging), timeout=600)
            except subprocess.TimeoutExpired:
                rec["last_pull_error"] = f"checkpoint pull of {name} timed out at {now()}"
                staging.unlink(missing_ok=True)
                continue
            if staging.exists():
                entry = {"path": name, "bytes": staging.stat().st_size, "sha256": hashlib.sha256(staging.read_bytes()).hexdigest(), "route": "single"}
        if entry is None:
            continue
        if dest.exists() and 0 < dest.stat().st_size > entry["bytes"]:
            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            rotated = dest.with_name(f"{name}.rotated-{stamp}")
            suffix = 2
            while rotated.exists():
                rotated = dest.with_name(f"{name}.rotated-{stamp}-{suffix}")
                suffix += 1
            dest.rename(rotated)
            entry["rotated"] = {"to": rotated.name, "bytes": rotated.stat().st_size}
            rec["last_pull_rotation"] = f"{name} rotated to {rotated.name} at {now()}"
        staging.replace(dest)
        pulled_now.append(entry)
        if stat is not None:
            stored[name] = stat
    if pulled_now:
        rec["last_checkpoint_pull_at"] = now()
        # Accumulate into the record's pulled list, one entry
        # per path, latest pull winning: the terminal record
        # and the printed result report every output the run
        # landed, whichever cadence moved it.
        by_path = {entry["path"]: entry for entry in rec.get("pulled", [])}
        for entry in pulled_now:
            by_path[entry["path"]] = entry
        rec["pulled"] = list(by_path.values())
    return rec.get("pulled", [])


def finalize_run(rec: dict, job: dict, session: str, remote_out: str, reader_state: dict, usage_before) -> tuple[int, dict]:
    """The terminal tail, shared by the foreground poll loop and
    --poll: final pull, the payload's own exit code, the terminal
    record + its one outbox event. Returns (exit_code, result).

    The payload's checkpoint exit_code is the truth about the
    outcome (2026-11-05: a job-zero build whose init_venv.py
    failed recorded "complete" with a clean-looking pull; only a
    human reading the pulled report saw assertions_passed:
    false). Jobs whose checkpoints carry no exit_code fall back
    to the launch wrapper's exit stamp — the same truth for
    payloads that never write a checkpoint. Outputs are pulled
    regardless — reports and
    verdicts land locally either way."""
    pulled = pull_outputs(rec, job, session, remote_out, reader_state)
    exit_code = (reader_state.get("checkpoint") or {}).get("exit_code")
    if exit_code is None:
        exit_code = reader_state.get("exit_stamp")
    usage_after = colab("usage", timeout=120).stdout.strip()
    if exit_code not in (None, 0):
        mark_terminal(rec, "failed", finished_at=now(), error=f"job payload exited {exit_code}", pulled=pulled, usage_before=usage_before, usage_after=usage_after)
        return 1, {"run_id": rec["run_id"], "state": "failed", "error": rec["error"], "pulled": pulled}
    mark_terminal(rec, "complete", finished_at=now(), pulled=pulled, usage_before=usage_before, usage_after=usage_after)
    return 0, {"run_id": rec["run_id"], "state": "complete", "pulled": pulled}


def close_out_lease(rec: dict) -> None:
    """The terminal close-out for a run reconciled by --poll:
    what the foreground poller's finally does — release the job
    registration (finish_job no-ops when none matches) and
    capture the transient state."""
    if lease.load_config(REPO).get("enabled"):
        lease.finish_job(REPO, rec["run_id"])
    mirror("capture")


def poll_run(run_id: str) -> int:
    """One bounded reconcile of a launched run (E5): orphan
    sweep, one reader exec, one pull, one record update — nothing
    here waits, so any caller (an agent, a scheduler job) can
    drive a detached run to its terminal state by repeating the
    verb. Exit 0 complete, 1 failed/orphaned, 2 no such run or
    not staged, 3 still running."""
    rec = load_run_record(run_id)
    if rec is None:
        print(f"colab-run --poll: no run record at {RUNS / f'{run_id}.json'}", file=sys.stderr)
        return 2
    if not TOKEN.exists() and not os.environ.get("COLAB_BIN"):
        print("colab-run: STAGED — no colab login yet. Run ops/bootstrap_local.sh, then the one-time login (see README).", file=sys.stderr)
        return 2
    manifest_path = REPO / "jobs" / str(rec.get("job")) / "job.json"
    if not manifest_path.exists():
        print(f"colab-run --poll: no job manifest at {manifest_path}", file=sys.stderr)
        return 2
    job = json.loads(manifest_path.read_text())
    orphan_sweep()
    rec = load_run_record(run_id) or rec
    if rec.get("state") in TERMINAL_STATES:
        print(json.dumps({"run_id": run_id, "state": rec["state"]}, indent=2))
        return 0 if rec["state"] == "complete" else 1
    session = rec.get("session")
    remote_out = rec.get("remote_out")
    if not session or not remote_out:
        print(json.dumps({"run_id": run_id, "state": rec.get("state"), "error": "record predates launch (no session/remote_out); --resume relaunches it"}, indent=2))
        return 1
    reader = write_reader(run_id, remote_out, job.get("outputs", []))
    poll_timeout = int(os.environ.get("COLAB_RUN_POLL_TIMEOUT_S", "300"))
    state, poll_error = read_reader(session, reader, poll_timeout)
    if state is None:
        if register_poll_failure(rec, session, poll_error) == "failed":
            close_out_lease(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
            return 1
        print(json.dumps({"run_id": run_id, "state": rec["state"]}, indent=2))
        return 3
    rec["poll_failures"] = 0
    done_units = (state.get("checkpoint") or {}).get("completed_units", 0)
    rec["last_checkpoint_units"] = done_units
    save_record(rec)
    if job.get("outputs"):
        pull_outputs(rec, job, session, remote_out, state)
        save_record(rec)
    log = state.get("heartbeat_tail") or []
    complete = any("complete" in ln for ln in log) or (job.get("units") and done_units >= job["units"]) or state.get("exit_stamp") is not None
    if not complete and not state.get("job_pids") and state.get("job_log_tail"):
        # The launched process is gone with no completion signal:
        # the same death the poll loop fails on (see main).
        tail = "\n".join(state["job_log_tail"])
        mark_terminal(rec, "failed", error=(f"job exited before completing; remote log tail: {tail}")[-500:])
        close_out_lease(rec)
        print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
        return 1
    past_deadline = False
    try:
        past_deadline = time.time() >= datetime.fromisoformat(rec["started_at"]).timestamp() + job.get("timeout", 18000)
    except (KeyError, ValueError):
        past_deadline = False
    if complete or past_deadline:
        rc, result = finalize_run(rec, job, session, remote_out, state, rec.get("usage_before"))
        close_out_lease(rec)
        print(json.dumps(result, indent=2))
        return rc
    print(json.dumps({"run_id": run_id, "state": rec["state"]}, indent=2))
    return 3


def wait_run(run_id: str, max_seconds: int) -> int:
    """A bounded wait over the LOCAL run record only (E13): zero
    channel use — no CLI call, no lease read — so waiting never
    becomes the polling loop it replaces. Exit 0 complete, 1
    failed/orphaned, 2 no such record, 3 still running when the
    bound runs out."""
    if not (RUNS / f"{run_id}.json").exists():
        print(f"colab-run --wait: no run record for {run_id}", file=sys.stderr)
        return 2
    end = time.time() + max_seconds
    while True:
        rec = load_run_record(run_id)
        state = (rec or {}).get("state")
        if state == "complete":
            print(json.dumps({"run_id": run_id, "state": state}))
            return 0
        if state in ("failed", "orphaned"):
            print(json.dumps({"run_id": run_id, "state": state}))
            return 1
        remaining = end - time.time()
        if remaining <= 0:
            print(json.dumps({"run_id": run_id, "state": state}))
            return 3
        time.sleep(min(2, remaining))


def orphan_notes(shape_id: str, shape: dict) -> list[str]:
    """E1, runner half — failure path only: after an acquire
    refusal, name any live-but-unrecorded sessions at the
    requested shape and print the verb that restores them, the
    refusal-prints-the-alternative pattern. Costs one live-list
    read, so it never runs on a hot path; never fatal — a nicety
    must not mask the refusal it annotates."""
    try:
        live = lease.live_sessions(colab, REPO)
        if not live:
            return []
        recorded = {r.get("session") for r in lease.all_records(REPO)}
        want_class = "high_ram" if (shape or {}).get("high_mem") else "standard"
        notes = []
        for entry in live:
            name = entry["session"]
            if name in recorded or entry.get("shape_class") not in (None, want_class):
                continue
            notes.append(f"colab-run: note: session {name} is live but has no lease record (orphaned) — restore it with: bin/colab-lease adopt {name}")
        return notes
    except Exception:  # noqa: BLE001
        return []


def main() -> int:
    args = sys.argv[1:]
    # Verbs that never launch dispatch first: --sweep reconciles
    # records, --poll reconciles one launched run, --wait reads
    # the local record only. None of them may pay the launch
    # path's costs (mirror restore, catalog, acquire).
    core_args = args[: args.index("--")] if "--" in args else list(args)
    if "--sweep" in core_args:
        findings, live_ok = orphan_sweep()
        print(json.dumps({"findings": findings, "live_list_unreadable": not live_ok}, indent=2))
        return 0
    if "--poll" in core_args:
        idx = core_args.index("--poll")
        if idx + 1 >= len(core_args):
            print("usage: colab-run --poll RUN_ID", file=sys.stderr)
            return 2
        return poll_run(core_args[idx + 1])
    if "--wait" in core_args:
        idx = core_args.index("--wait")
        if idx + 1 >= len(core_args):
            print("usage: colab-run --wait RUN_ID [--max SECONDS]", file=sys.stderr)
            return 2
        max_seconds = 120
        if "--max" in core_args:
            midx = core_args.index("--max")
            if midx + 1 >= len(core_args):
                print("usage: colab-run --wait RUN_ID [--max SECONDS]", file=sys.stderr)
                return 2
            try:
                max_seconds = int(core_args[midx + 1])
            except ValueError:
                print("colab-run --wait: --max must be an integer number of seconds", file=sys.stderr)
                return 2
        return wait_run(core_args[idx + 1], max_seconds)
    # Flags travel in pairs and may sit on either side of the job
    # name — extract them first and take the first remaining token
    # as the job. (Job-first-only parsing read a leading --caller
    # as a job name; it bit a consumer following shorthand in a
    # message, 2026-11-05.)
    resume = caller_flag = None
    seed_flag = detach_flag = False
    extra_args = []
    positional = []
    i = 0
    while i < len(args):
        if args[i] == "--":
            # Everything after -- is the job's own argv (the repo
            # selection seam: env-build -- --repo <id> reaches
            # env_build.sh without a manifest per repo).
            extra_args = args[i + 1:]
            break
        if args[i] == "--seed":
            seed_flag = True
            i += 1
        elif args[i] == "--detach":
            detach_flag = True
            i += 1
        elif args[i] == "--resume" and i + 1 < len(args):
            resume = args[i + 1]
            i += 2
        elif args[i] == "--caller" and i + 1 < len(args):
            caller_flag = args[i + 1]
            i += 2
        else:
            positional.append(args[i])
            i += 1
    if not positional:
        print("usage: colab-run <job-name> [--resume RUN_ID] [--caller TAG] [--seed] [--detach] [-- <job args>...]", file=sys.stderr)
        return 2
    job_name = positional[0]
    manifest_path = REPO / "jobs" / job_name / "job.json"
    if not manifest_path.exists():
        print(f"no job manifest at {manifest_path}", file=sys.stderr)
        return 2
    job = json.loads(manifest_path.read_text())
    # Caller claim: flag over the manifest's caller key over
    # $COLAB_CALLER; a presented but unregistered claim is refused
    # at claim time, before anything starts.
    claim_raw = caller_flag if caller_flag is not None else job.get("caller")
    claim_err = lease.caller_claim_error(REPO, flag=claim_raw, env=os.environ.get("COLAB_CALLER"))
    if claim_err:
        print(f"colab-run: {claim_err}", file=sys.stderr)
        return 2
    caller = lease.resolve_caller(REPO, flag=claim_raw, env=os.environ.get("COLAB_CALLER"))
    if not TOKEN.exists() and not os.environ.get("COLAB_BIN"):
        print("colab-run: STAGED — no colab login yet. Run ops/bootstrap_local.sh, then the one-time login (see README).", file=sys.stderr)
        return 2

    mirror("restore")

    # A manifest may name its shape; otherwise the config's
    # default_shape is the only fallback — no shape is hardcoded
    # here, and an unresolvable shape fails loudly.
    shape_id = job.get("shape") or lease.default_shape(REPO)
    shapes = lease.catalog_shapes(REPO, colab)
    if not shape_id or shape_id not in shapes:
        print(f"colab-run: job {job_name} names no usable shape (manifest shape or config default_shape required)", file=sys.stderr)
        return 2
    shape = shapes[shape_id]
    run_id = resume or f"{job_name}-{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}"
    rec = None
    if resume:
        # A resume continues the run on disk: its launch facts
        # (started_at above all) are the run's history and are
        # never re-stamped — the resume adds its own facts.
        # (2026-11-06: a resumed hold came back stamped with the
        # resume moment, erasing its launch time.)
        prior = RUNS / f"{run_id}.json"
        if prior.exists():
            rec = load_run_record(run_id)
            if rec is None:
                # A torn prior (a flap-killed fire's 0-byte
                # record) holds nothing to preserve: the resume
                # starts the run fresh rather than crashing
                # every later entry on the damaged file.
                print(f"colab-run: prior record for {run_id} is unreadable (torn); starting fresh", file=sys.stderr)
            else:
                # A resurrected run announces its NEW terminal state
                # afresh: the sweep's orphan event is history, not
                # this run's outcome.
                rec.pop("terminal_event_state", None)
                rec.pop("terminal_event_at", None)
                rec.update(state="starting", resumed=True, resumed_at=now())
    if rec is None:
        rec = {"run_id": run_id, "job": job_name, "shape": shape_id, "state": "starting", "started_at": now(), "resumed": bool(resume)}
    if caller:
        rec["caller"] = caller
    save_record(rec)
    # Bundle seed (--seed — env-build's private-repo route): the
    # job's target repo reaches the VM as a snapshot bundle, never
    # as a VM-side clone. A private repo's plain HTTPS clone
    # cannot authenticate on the VM (no credential lives there by
    # design), so before launch the runner builds the bundle from
    # the registry entry's local checkout (the same builder
    # colab-check ships), uploads it, and seeds the dest from it
    # (sync/apply_bundle_remote.py's seed mode); the job then runs
    # with --skip-clone. Built here, before any session is held,
    # so a local build failure holds nothing.
    seed_ctx = None
    if seed_flag and not resume:
        def _extra(flag):
            return extra_args[extra_args.index(flag) + 1] if flag in extra_args and extra_args.index(flag) + 1 < len(extra_args) else None
        try:
            registry = repo_registry.load_local_registry(REPO)
            seed_repo_id, seed_entry = repo_registry.get_entry(registry, _extra("--repo"))
            seed_dest = repo_registry.variant_dest(seed_entry, _extra("--variant"))
        except ValueError as exc:
            rec.update(state="failed", error=f"bundle seed: {exc}")
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
            return 1
        bundle_env = dict(os.environ)
        bundle_env["COLAB_REPO_SRC"] = str(Path(os.path.expanduser(seed_entry["local_path"])))
        bundle = subprocess.run(["bash", str(REPO / "sync" / "make_snapshot_bundle.sh")], capture_output=True, text=True, env=bundle_env)
        if bundle.returncode != 0:
            rec.update(state="failed", error=f"bundle seed: snapshot build failed: {bundle.stderr[-300:]}")
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
            return 1
        seed_manifest = json.loads(bundle.stdout)
        seed_ctx = {"repo": seed_repo_id, "dest": seed_dest, "clone_url": seed_entry["clone_url"], "bundle_path": Path(seed_manifest["bundle"]), "manifest": seed_manifest}
        rec["bundle_seed"] = {"repo": seed_repo_id, "dest": seed_dest, "sha256": seed_manifest["sha256"], "bytes": seed_manifest["bytes"], "snapshot_commit": seed_manifest["snapshot_commit"], "tree": seed_manifest["tree"]}
        save_record(rec)
    usage_before = colab("usage", timeout=120).stdout.strip()
    # Lease model (sync/lease/): adopt-or-acquire the shared session and
    # leave it up at the end; the reaper owns its lifecycle. With the lease
    # disabled in config, fall back to the original per-job session.
    use_lease = bool(lease.load_config(REPO).get("enabled"))
    if detach_flag and not use_lease:
        # --detach leaves the job running with no poller; the
        # lease-disabled fallback's per-run session is stopped by
        # the poller's own finally, so a detached launch there
        # would kill the job it just started.
        rec.update(state="failed", error="--detach requires the lease path (lease.enabled); the fallback per-job session dies with the poller")
        save_record(rec)
        print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
        return 2
    session = run_id  # the lease-disabled fallback's per-run session
    if use_lease:
        got = lease.acquire(colab, REPO, shape_id, via="runner", caller=caller)
        if got["action"] in ("refused-budget", "create-failed", "shape-refused", "shape-mismatch", "caller-start-refused", "unknown-shape"):
            rec.update(state="failed", error=json.dumps(got)[:300])
            save_record(rec)
            # E1: if live sessions sit unrecorded at this shape,
            # the refusal may be the record loss talking — name
            # the state and the verb that restores it (stderr;
            # stdout stays the run's JSON result).
            for note in orphan_notes(shape_id, shape):
                print(note, file=sys.stderr)
            print(json.dumps({"run_id": run_id, "state": "failed", "lease": got}, indent=2))
            return 1
        rec["lease_action"] = got["action"]
        # The lease's session is whatever the acquire created or
        # adopted — a generated name, never a configured one.
        session = got["record"]["session"]
        rec["session"] = session
        lease.touch_job(REPO, run_id)
        save_record(rec)
    if not use_lease:
        rec["session"] = session
        save_record(rec)
        # Session shape gate for the fallback's own `new` below (the
        # lease path is gated inside acquire): a job run is an agent
        # actor unless the env claim says otherwise. A refusal fails
        # the run before any session is created.
        refusal = lease.enforce_session_admission(REPO, shape_id, via="runner", shape=shape, seam="runner", caller=caller)
        if refusal is not None:
            rec.update(state="failed", error=json.dumps(refusal)[:300])
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "lease": refusal}, indent=2))
            return 1
    detached = False
    try:
        if not use_lease:
            new_args = ["new", "-s", session] + lease._session_shape_args(shape)
            r = colab(*new_args, timeout=600)
            if r.returncode != 0 and "already" not in (r.stdout + r.stderr):
                rec.update(state="failed", error=(r.stderr or r.stdout).strip()[-300:])
                save_record(rec)
                return 1
        script = REPO / job["script"]
        # The remote script slot is scoped to this run: the bare
        # basename is one shared slot per session, and two jobs
        # whose scripts share a basename (every lane's run.py)
        # overwrote each other between upload and launch — a run
        # then executed a foreign payload with its own args
        # (2026-11-08 remainder lanes: an eraattr payload ran
        # under a rem20d launch). The payload never names its own
        # slot (the runner invokes it), so scoping is safe;
        # manifest uploads keep their contract names by contrast.
        remote_script = f"{run_id}-{script.name}"
        err = upload_one(session, script, remote_script, run_id)
        if err is not None:
            rec.update(state="failed", error=f"runner script upload: {err}")
            save_record(rec)
            print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
            return 1
        # Manifest-declared extra uploads land at /content/<name>
        # before launch: a shell_job payload names its script in
        # args (--script /content/env_build.sh) and the registry it
        # reads (/content/repos.json), and neither is the runner
        # script itself. Until this loop existed nothing uploaded
        # them, so env-build's shell_job refused in its first
        # second (2026-11-05) — a declared upload missing locally
        # fails the run here, never launches a job that cannot run.
        for extra in job.get("uploads", []):
            src = REPO / extra
            if not src.is_file():
                rec.update(state="failed", error=f"manifest upload missing locally: {extra}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            err = upload_one(session, src, src.name, run_id)
            if err is not None:
                rec.update(state="failed", error=f"manifest upload failed: {extra}: {err}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
        seeded = False
        if seed_ctx is not None:
            # Move the bundle (chunked — it can exceed the
            # single-file ceiling), its manifest, and the apply
            # script, then seed the dest on the VM and verify the
            # manifest's tree in the seed's own output before any
            # launch: a seed that did not land is a failed run,
            # never a job launched against a missing tree.
            up = transfer.chunked_upload(session, seed_ctx["bundle_path"], seed_ctx["bundle_path"].name)
            if not up["ok"]:
                rec.update(state="failed", error=f"bundle seed: chunked upload failed: {json.dumps(up)[:300]}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            err = upload_one(session, Path(str(seed_ctx["bundle_path"]) + ".manifest.json"), seed_ctx["bundle_path"].name + ".manifest.json", run_id)
            if err is None:
                err = upload_one(session, REPO / "sync" / "apply_bundle_remote.py", "apply_bundle_remote.py", run_id)
            if err is not None:
                rec.update(state="failed", error=f"bundle seed: {err}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            seed_remote = REPO / "var" / f"seed-{run_id}.py"
            seed_remote.write_text(
                "import subprocess\n"
                f"r = subprocess.run(['python3','apply_bundle_remote.py','{seed_ctx['bundle_path'].name}','{seed_ctx['dest']}','--origin-url','{seed_ctx['clone_url']}'], capture_output=True, text=True)\n"
                "print(r.stdout); print(r.stderr[-500:])\n"
            )
            sr = colab("exec", "-s", session, "--timeout", "1800", "-f", str(seed_remote), timeout=1900)
            if '"applied": true' not in sr.stdout or seed_ctx["manifest"]["tree"] not in sr.stdout:
                rec.update(state="failed", error=f"bundle seed: seed did not verify: {sr.stdout.strip()[-300:]}")
                save_record(rec)
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
            seeded = True
        # Relative to the session working dir (/content on a real Colab VM;
        # the fake CLI's sandbox root under test) so the same code runs both.
        # Per-run: a fixed dir leaks the previous run's heartbeat tail,
        # checkpoint, and outputs into this run's completion check.
        remote_out = f"{job_name}-out-{run_id}"
        rec.update(state="running", remote_out=remote_out, extra_args=extra_args)
        save_record(rec)
        # Detached launch (default pending the kill-matrix verdict): a short
        # exec starts the job under nohup; the CLI is never the job's lifeline.
        # The payload runs under a stamp wrapper: its exit code lands at
        # <remote_out>.exit-code, so a payload that never writes a
        # checkpoint still reports its outcome truthfully (2026-11-08:
        # checkpoint-less gate jobs recorded failed on green runs).
        job_args = "".join(f",'{a}'" for a in list(job.get("args", [])) + (["--skip-clone"] if seeded else []) + extra_args)
        stamp = (
            "import subprocess, sys\n"
            f"rc = subprocess.run([sys.executable, '{remote_script}', '--out', '{remote_out}'{job_args}]).returncode\n"
            f"open('{remote_out}.exit-code', 'w').write(str(rc))\n"
        )
        launch = (
            f"import subprocess; subprocess.Popen(['nohup','python3','-c',{stamp!r}],"
            f" stdout=open('{remote_out}.log','w'), stderr=subprocess.STDOUT, start_new_session=True)"
        )
        launcher = REPO / "var" / f"launch-{run_id}.py"
        launcher.parent.mkdir(parents=True, exist_ok=True)
        launcher.write_text(launch + "\nprint('launched')\n")
        colab("exec", "-s", session, "--timeout", "120", "-f", str(launcher), timeout=300)
        rec["state"] = "polling"
        save_record(rec)
        reader = write_reader(run_id, remote_out, job.get("outputs", []))
        if detach_flag:
            # E5: launch exactly as the foreground form, write
            # the record, return. usage_before is stamped now —
            # the reconcile that finalizes this run reads it from
            # the record, not from a dead process's locals. The
            # finally below skips the close-out for a detached
            # launch: no finish_job (the registration is the
            # run's liveness evidence), no stop, no capture.
            detached = True
            rec["detached_launch"] = True
            rec["usage_before"] = usage_before
            save_record(rec)
            print(json.dumps({"run_id": run_id, "session": session, "state": rec["state"]}, indent=2))
            return 0
        deadline = time.time() + job.get("timeout", 18000)
        cadence = job.get("checkpoint_pull_seconds", 300)
        # A checkpoint poll that outlives its subprocess timeout
        # is a failed poll, not a dead poller (2026-11-06: an
        # uncaught TimeoutExpired killed the poller mid-run and
        # stranded the record at polling while the payload
        # completed). The timeout is env-tunable for the same
        # reason the cadence is a manifest value: tests shrink it.
        poll_timeout = int(os.environ.get("COLAB_RUN_POLL_TIMEOUT_S", "300"))
        state = {}
        while time.time() < deadline:
            time.sleep(cadence)
            # A failed poll — subprocess timeout or unreadable
            # answer — is counted, not fatal (2026-11-06: an
            # uncaught TimeoutExpired killed the poller and
            # stranded the record at polling while the payload
            # completed); E11 bounds the count and classifies it.
            state, poll_error = read_reader(session, reader, poll_timeout)
            if state is None:
                if register_poll_failure(rec, session, poll_error) == "failed":
                    print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                    return 1
                continue
            done_units = (state.get("checkpoint") or {}).get("completed_units", 0)
            rec["last_checkpoint_units"] = done_units
            rec["poll_failures"] = 0
            save_record(rec)
            if job.get("outputs"):
                pull_outputs(rec, job, session, remote_out, state)
                save_record(rec)
            log = state.get("heartbeat_tail") or []
            if any("complete" in ln for ln in log) or (job.get("units") and done_units >= job["units"]) or state.get("exit_stamp") is not None:
                break
            if not state.get("job_pids") and state.get("job_log_tail"):
                # The launched process is gone and its launcher log
                # is all that exists: the job died before producing
                # a checkpoint — shell_job refusing a never-uploaded
                # --script file is the proven case (2026-11-05: its
                # one-line refusal sat in this log while the poller
                # polled an empty out dir through two timeouts,
                # ~40 min of apparent progress). A completed job
                # always trips the completion check above in the
                # same poll, so reaching here means death, not
                # completion: fail with the log tail in hand.
                tail = "\n".join(state["job_log_tail"])
                mark_terminal(rec, "failed", error=(f"job exited before completing; remote log tail: {tail}")[-500:])
                print(json.dumps({"run_id": run_id, "state": "failed", "error": rec["error"]}, indent=2))
                return 1
        rc, result = finalize_run(rec, job, session, remote_out, state, usage_before)
        print(json.dumps(result, indent=2))
        return rc
    finally:
        # A detached launch returns with the job still running:
        # no finish_job (the registration is the run's liveness
        # evidence until a reconcile closes it out), no stop, no
        # capture — the reconcile owns the close-out.
        if not detached:
            if use_lease:
                lease.finish_job(REPO, run_id)
            else:
                colab("stop", "-s", session, timeout=120)
            mirror("capture")


if __name__ == "__main__":
    raise SystemExit(main())
