#!/usr/bin/env bash
# Sessions, default-session status, and compute-unit usage. Usage: colab-status [profile]
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_wrap.sh"
wrap_enter
"$COLAB_BIN" --auth oauth2 sessions || true
"$COLAB_BIN" --auth oauth2 status || true
"$COLAB_BIN" --auth oauth2 usage || true
