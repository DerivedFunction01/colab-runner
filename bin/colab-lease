#!/usr/bin/env python3
"""Thin CLI over sync/lease/ — the shared-session lease.

Usage: colab-lease status [session]|acquire --shape ID [--hours H] [--via TAG] [--caller TAG] [--create]|extend SESSION --hours H [--caller TAG]|adopt SESSION [--deadline ISO|--hours H] [--caller TAG] [--shape ID]|shorten SESSION (--deadline ISO|--hours H) [--caller TAG]|release [session]|release-session SESSION|reap|keepalive|auto|request [--shape ID] [--reason TEXT] [--caller TAG] [--at ISO-TIME]|unrequest|grant --hours H [--burst SHAPE]|extend-grant --hours H|ungrant|standing|state|budget-caps [--daily V] [--monthly V] [--standing-daily V]|admission --shape ID [--via TAG] [--caller TAG]|plan --shape ID
Prints one JSON result. `reap` is the reaper-hook duty (deadline +
orphan reconciliation across all lease records); `auto` is the
hook's auto-acquire duty (inert unless enabled in config/lease.json);
`request` records a lease demand that `auto` consumes; `--at ISO-TIME`
makes it a timed start the duty fires when due — data, not an agent
job. `grant` opens
a two-tier window whose standing lease the `standing` duty keeps up; `extend`
moves a lease's deadline later (delta-priced, flags the lease as a
renewable window); `adopt` plants a record for a live session that
has none, from the deadline evidence its journals carry (the
`orphans` state portion lists them); `shorten` moves a deadline
earlier, the mirror of `extend`; and `extend-grant` moves the grant's end the same
way; `state` is the UI's single read (records + grant + specs +
budget). `budget-caps` updates the budget caps in config/lease.json
(the panel's editor rides it); each value is a non-negative number
or `none` for no cap, and an omitted flag leaves its cap untouched.
`admission` is the session shape
gate's verdict for one shape (the session-creating wrappers that
bypass the lease core consult it): prints admitted, or the
shape-refused verdict with exit 1. `plan` mints a generated session
name plus the CLI args for one shape without creating anything
(the session-creating wrappers ride it, so name generation and
shape flags live in exactly one place).
"""

import importlib.util
import json
import os
import sys
from datetime import datetime
from importlib.machinery import SourceFileLoader
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "bin"))

spec = importlib.util.spec_from_loader("colab_run", SourceFileLoader("colab_run", str(REPO / "bin" / "colab-run")))
cr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(cr)

spec_l = importlib.util.spec_from_file_location(
    "lease", REPO / "sync" / "lease" / "__init__.py",
    submodule_search_locations=[str(REPO / "sync" / "lease")])
lease = importlib.util.module_from_spec(spec_l)
sys.modules["lease"] = lease
spec_l.loader.exec_module(lease)

TOKEN = Path.home() / ".config" / "colab-cli" / "token.json"


def parse_hours(rest: list[str]) -> tuple[float | None, list[str], str | None]:
    """Pull `--hours H` out of an argument list. Returns (hours,
    remaining, error): hours is None when the flag is absent."""
    hours, out = None, []
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok == "--hours":
            if i + 1 >= len(rest):
                return None, out, "--hours needs a value"
            try:
                hours = float(rest[i + 1])
            except ValueError:
                return None, out, "--hours needs a number"
            i += 2
        else:
            out.append(tok)
            i += 1
    if hours is not None and hours <= 0:
        return None, out, "--hours must be > 0"
    return hours, out, None


def parse_flag(rest: list[str], flag: str) -> tuple[str | None, list[str], str | None]:
    """Pull `--flag VALUE` out of an argument list. Returns (value,
    remaining, error): value is None when the flag is absent."""
    value, out = None, []
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok == flag:
            if i + 1 >= len(rest):
                return None, out, f"{flag} needs a value"
            value = rest[i + 1]
            i += 2
        else:
            out.append(tok)
            i += 1
    return value, out, None


def resolve_cli_caller(flag: str | None) -> tuple[str | None, str | None]:
    """Resolve a --caller flag against $COLAB_CALLER through the
    core's registry. Returns (caller, error): a presented but
    unregistered claim is an error — refused at claim time — while
    no claim at all is (None, None), an unattributed call."""
    env = os.environ.get("COLAB_CALLER")
    err = lease.caller_claim_error(REPO, flag=flag, env=env)
    if err:
        return None, err
    return lease.resolve_caller(REPO, flag=flag, env=env), None


def shape_arg(rest: list[str]) -> tuple[str | None, list[str], str | None]:
    """The shape a verb acts on: the --shape flag, else the first
    positional. Returns (shape, remaining, error)."""
    shape, rest, err = parse_flag(rest, "--shape")
    if err:
        return None, rest, err
    positional = [t for t in rest if not t.startswith("--")]
    if shape is None and positional:
        shape = positional[0]
    return shape, rest, None


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] not in ("status", "acquire", "extend", "adopt", "shorten", "release", "release-session", "reap", "keepalive", "auto", "request", "unrequest", "grant", "extend-grant", "ungrant", "standing", "state", "budget-caps", "admission", "plan"):
        print(__doc__.strip().split("\n")[2], file=sys.stderr)
        return 2
    if not TOKEN.exists() and not os.environ.get("COLAB_BIN"):
        print("colab-lease: STAGED — no colab login yet.", file=sys.stderr)
        return 2
    cr.mirror("restore")
    cmd = args[0]
    if cmd == "status":
        session = args[1] if len(args) > 1 else None
        result = lease.status(cr.colab, REPO, session)
    elif cmd == "acquire":
        hours, rest, err = parse_hours(args[1:])
        create = "--create" in rest
        rest = [a for a in rest if a != "--create"]
        via = None
        caller_flag = None
        if err is None:
            via, rest, err = parse_flag(rest, "--via")
        if err is None:
            caller_flag, rest, err = parse_flag(rest, "--caller")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(caller_flag)
        shape = None
        if err is None:
            shape, rest, err = shape_arg(rest)
        if err is None and shape is None:
            err = "acquire requires --shape ID"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.acquire(cr.colab, REPO, shape, hours=hours, via=via, caller=caller, create=create)
        if result.get("host_changed") and result.get("record"):
            # Initiation-time approval, Step 2: this entry point just
            # birthed (or adopted) a session on a new tunnel host —
            # prime this scope's own approval card now, in the same
            # minute, rather than letting it surface on a later call.
            result["prime"] = lease.prime_session_host(cr.colab, REPO, result["record"]["session"])
    elif cmd == "extend":
        hours, rest, err = parse_hours(args[1:])
        caller_flag = None
        if err is None:
            caller_flag, rest, err = parse_flag(rest, "--caller")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(caller_flag)
        if err is None and hours is None:
            err = "extend requires --hours H (H > 0)"
        positional = [t for t in rest if not t.startswith("--")]
        if err is None and not positional:
            err = "extend requires a session name"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.extend(cr.colab, REPO, positional[0], hours, caller=caller)
    elif cmd == "adopt":
        hours, rest, err = parse_hours(args[1:])
        deadline_raw = None
        caller_flag = None
        shape_flag = None
        if err is None:
            deadline_raw, rest, err = parse_flag(rest, "--deadline")
        if err is None:
            caller_flag, rest, err = parse_flag(rest, "--caller")
        if err is None:
            shape_flag, rest, err = parse_flag(rest, "--shape")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(caller_flag)
        deadline = None
        if err is None and deadline_raw is not None:
            if hours is not None:
                err = "adopt takes --deadline or --hours, not both"
            else:
                try:
                    deadline = datetime.fromisoformat(deadline_raw)
                except ValueError:
                    err = "--deadline needs an ISO timestamp"
        positional = [t for t in rest if not t.startswith("--")]
        if err is None and not positional:
            err = "adopt requires a session name"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.adopt_orphan(cr.colab, REPO, positional[0], deadline=deadline, hours=hours, caller=caller, shape=shape_flag)
    elif cmd == "shorten":
        hours, rest, err = parse_hours(args[1:])
        deadline_raw = None
        caller_flag = None
        if err is None:
            deadline_raw, rest, err = parse_flag(rest, "--deadline")
        if err is None:
            caller_flag, rest, err = parse_flag(rest, "--caller")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(caller_flag)
        deadline = None
        if err is None:
            if (deadline_raw is None) == (hours is None):
                err = "shorten requires exactly one of --deadline ISO or --hours H"
            elif deadline_raw is not None:
                try:
                    deadline = datetime.fromisoformat(deadline_raw)
                except ValueError:
                    err = "--deadline needs an ISO timestamp"
        positional = [t for t in rest if not t.startswith("--")]
        if err is None and not positional:
            err = "shorten requires a session name"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.shorten(cr.colab, REPO, positional[0], deadline=deadline, hours=hours, caller=caller)
    elif cmd == "release":
        session = args[1] if len(args) > 1 else None
        result = lease.release(cr.colab, REPO, session=session)
    elif cmd == "grant":
        hours, rest, err = parse_hours(args[1:])
        burst = None
        i = 0
        while err is None and i < len(rest):
            if rest[i] == "--burst" and i + 1 < len(rest):
                burst = rest[i + 1]
                i += 2
            else:
                i += 1
        if err is None and hours is None:
            err = "grant requires --hours H (H > 0)"
        if err is None and burst is not None and burst not in lease.catalog_shapes(REPO, cr.colab):
            err = f"unknown burst shape {burst!r}"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.write_grant(REPO, hours, burst_shape=burst)
    elif cmd == "extend-grant":
        hours, rest, err = parse_hours(args[1:])
        if err is None and hours is None:
            err = "extend-grant requires --hours H (H > 0)"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.extend_grant(cr.colab, REPO, hours)
    elif cmd == "ungrant":
        result = lease.ungrant(cr.colab, REPO)
    elif cmd == "standing":
        result = lease.standing_duty(cr.colab, REPO)
        result["bridge"] = lease.bridge_duty(cr.colab, REPO)
    elif cmd == "state":
        rest = args[1:]
        portions = {
            "records": lease.state_records,
            "specs": lease.state_specs,
            "budget": lease.state_budget,
            "grant": lease.state_grant,
            "meta": lease.state_meta,
            "orphans": lease.state_orphans,
        }
        if not rest:
            result = lease.state(cr.colab, REPO)
        elif len(rest) == 2 and rest[0] == "--part" and rest[1] in portions:
            result = portions[rest[1]](cr.colab, REPO)
        else:
            print("colab-lease: state takes [--part records|specs|budget|grant|meta|orphans]", file=sys.stderr)
            return 2
    elif cmd == "budget-caps":
        updates = {}
        err = None
        rest = args[1:]
        flags = {"--daily": "daily", "--monthly": "monthly", "--standing-daily": "standing_daily"}
        i = 0
        while err is None and i < len(rest):
            tok = rest[i]
            if tok not in flags:
                err = f"unknown argument {tok!r}"
            elif i + 1 >= len(rest):
                err = f"{tok} needs a value (a number or 'none')"
            else:
                raw = rest[i + 1]
                if raw.lower() == "none":
                    updates[flags[tok]] = None
                else:
                    try:
                        updates[flags[tok]] = float(raw)
                    except ValueError:
                        err = f"{tok} needs a number or 'none'"
                i += 2
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        result = lease.set_budget_caps(REPO, **updates)
    elif cmd == "admission":
        via, rest, err = parse_flag(args[1:], "--via")
        caller_flag = None
        if err is None:
            caller_flag, rest, err = parse_flag(rest, "--caller")
        caller = None
        if err is None:
            caller, err = resolve_cli_caller(caller_flag)
        shape = None
        if err is None:
            shape, rest, err = shape_arg(rest)
        if err is None and shape is None:
            err = "admission requires --shape ID"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        if shape not in lease.catalog_shapes(REPO):
            result = {"action": "unknown-shape", "shape": shape}
        else:
            refusal = lease.enforce_session_admission(REPO, shape, via=via, seam="wrapper", caller=caller)
            result = refusal if refusal is not None else {"action": "admitted", "shape": shape, "caller": caller}
    elif cmd == "plan":
        shape, rest, err = shape_arg(args[1:])
        if err is None and shape is None:
            err = "plan requires --shape ID"
        if err is None and shape not in lease.catalog_shapes(REPO, cr.colab):
            err = f"unknown shape {shape!r}"
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        entry = lease.catalog_shapes(REPO, cr.colab)[shape]
        session = lease.generate_session_name(REPO, cr.colab)
        result = {"action": "planned", "shape": shape, "session": session, "args": ["new", "-s", session] + lease._session_shape_args(entry)}
    elif cmd == "keepalive":
        rec = lease.load_record(REPO)
        if not rec:
            result = {"action": "no-lease"}
        else:
            launched = lease.ensure_keepalive(cr.colab, REPO, rec["session"])
            import time as _time

            _time.sleep(3)
            age = lease.heartbeat_age(cr.colab, REPO, rec["session"])
            result = {"action": "keepalive-ensured", **launched, "heartbeat_age_s": round(age, 1) if age is not None else None}
    elif cmd == "auto":
        result = lease.auto_acquire(cr.colab, REPO)
    elif cmd == "request":
        shape, reason, claim, at = None, "", None, None
        rest = args[1:]
        while rest:
            tok, rest = rest[0], rest[1:]
            if tok == "--reason" and rest:
                reason, rest = rest[0], rest[1:]
            elif tok in ("--caller", "--via") and rest:
                # --via is the caller claim's legacy spelling; both
                # feed the one governed claim.
                claim, rest = rest[0], rest[1:]
            elif tok == "--shape" and rest:
                shape, rest = rest[0], rest[1:]
            elif tok == "--at" and rest:
                at, rest = rest[0], rest[1:]
            elif not tok.startswith("--"):
                shape = tok
        caller, err = resolve_cli_caller(claim)
        if err:
            print(f"colab-lease: {err}", file=sys.stderr)
            return 2
        if at is not None:
            try:
                datetime.fromisoformat(at)
            except ValueError:
                print("colab-lease: --at needs an ISO timestamp", file=sys.stderr)
                return 2
        result = lease.write_request(REPO, reason=reason, shape=shape, caller=caller, not_before=at)
    elif cmd == "release-session":
        if len(args) < 2:
            print("colab-lease: release-session needs a session name", file=sys.stderr)
            return 2
        result = lease.release_session(cr.colab, REPO, args[1])
    elif cmd == "unrequest":
        had = lease.load_request(REPO) is not None
        lease.clear_request(REPO)
        result = {"action": "request-cleared" if had else "no-demand"}
    else:
        result = lease.reap(cr.colab, REPO)
    print(json.dumps(result, indent=2))
    cr.mirror("capture")
    return 0 if result.get("action") not in ("refused-budget", "create-failed", "auto-failed", "standing-failed", "standing-refused-budget", "extend-no-lease", "extend-unknown", "extend-standing-managed", "grant-inactive", "caps-invalid", "unknown-shape", "shape-refused", "shape-mismatch", "caller-start-refused", "session-has-record", "session-stop-failed", "adopt-has-record", "adopt-absent", "adopt-unknown", "adopt-deadline-past", "adopt-deadline-shortens", "adopt-no-deadline", "adopt-shape-ambiguous", "adopt-shape-unknown", "adopt-shape-conflict", "adopt-bridge-managed", "adopt-handover-pending", "shorten-no-lease", "shorten-unknown", "shorten-standing-managed", "shorten-not-earlier", "shorten-deadline-past", "shorten-no-target") else 1


if __name__ == "__main__":
    raise SystemExit(main())
