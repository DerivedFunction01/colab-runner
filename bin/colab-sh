#!/usr/bin/env python3
"""Bare-shell channel to a leased Colab session, over real SSH.

Usage:
  colab-sh [-s SESSION] [--caller TAG] [--dir DIR] [--timeout SECONDS]
           [--env K=V ...] ('inline command' | -f script.sh | -- args...)
           [< script]
  colab-sh --detach [same options] (command | -f script.sh) [< script]
  colab-sh --poll ID [-s SESSION] [--caller TAG]

The official CLI's `exec` runs Python inside the session's IPython
kernel (sys.argv leaks, SystemExit non-fatal, kernel state shared).
This wrapper instead drives the CLI's own SSH bridge
(`colab ssh --proxy-mode`, a WebSocket to the runtime's /colab/ssh
endpoint) with the system `ssh`, so the remote side is a plain bash
process: real exit codes, clean stdout/stderr, no kernel involved.
The script (inline, file, or stdin) is delivered on ssh's stdin to
`bash -s`; anything after `--` becomes the script's positional args.

Rules:
- Targets an existing session only — the active lease's session by
  default. It never creates a session: the target must read alive
  server-side before connecting (verified via the lease machinery's
  own read), because the CLI's ssh flow otherwise assigns a fresh
  default-shape runtime for a dead name; session lifecycle belongs
  to the lease.
- One SSH connection per runtime at a time (the server answers 429
  while another is connected). This wrapper is one-shot: it connects,
  runs, disconnects.
- Synchronous use is claim-gated: before connecting, the lease
  core's sync_rights verdict must allow this caller (a TTL'd claim
  held by the session's sole active caller; attaches auto-claim).
  A refusal exits 2 naming the holder, the evidence, and the
  detached alternative. --detach and --poll are the async path —
  seconds-long connects that launch or read in-session work — and
  stay open to every caller; they never take the claim. Lease- and
  runner-internal calls never pass through this gate by
  construction: they use the CLI funnel (sync/cli.py), not this
  wrapper.
- Auth is the local ~/.ssh/id_ed25519 key (ed25519/ecdsa only; the
  server rejects RSA). The CLI derives the offered public key from
  the same key, so the pair always matches.
- Colab/Google traffic bypasses this machine's egress proxy (the
  NO_PROXY suffix rule in AGENTS.md); ssh passes its environment to
  the ProxyCommand, so the fix set here reaches the bridge.
"""

import argparse
import base64
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CLI_VENV_PYTHON = (
    Path.home() / ".local" / "share" / "uv" / "tools" / "google-colab-cli" / "bin" / "python"
)
DEFAULT_IDENTITY = Path.home() / ".ssh" / "id_ed25519"
SSH_HOST = "root@colab-runtime"
PROXY_SUFFIXES = "google.com,googleapis.com,googleusercontent.com,colab.dev"


def proxy_env(env: dict) -> dict:
    """Return env with the Colab proxy-bypass suffixes appended."""
    out = dict(env)
    for key in ("NO_PROXY", "no_proxy"):
        cur = out.get(key)
        out[key] = f"{cur},{PROXY_SUFFIXES}" if cur else PROXY_SUFFIXES
    return out


def proxy_command(session: str) -> str:
    """The OpenSSH ProxyCommand bridging to the session's /colab/ssh."""
    return shlex.join(
        [
            str(CLI_VENV_PYTHON),
            "-m",
            "colab_cli.cli",
            "--auth",
            "oauth2",
            "ssh",
            "--proxy-mode",
            "-s",
            session,
        ]
    )


def ssh_argv(session: str, remote_dir: str, script_args: list, identity: Path) -> list:
    remote = f"cd {shlex.quote(remote_dir)} && bash -s"
    if script_args:
        remote += " -- " + " ".join(shlex.quote(a) for a in script_args)
    return [
        "ssh",
        "-o",
        f"ProxyCommand={proxy_command(session)}",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "LogLevel=ERROR",
        "-i",
        str(identity),
        SSH_HOST,
        remote,
    ]


def build_stdin(script: str, env_pairs: list) -> str:
    """Env exports (shlex-quoted) ahead of the script, exec-style."""
    lines = [f"export {k}={shlex.quote(v)}" for k, v in env_pairs]
    if lines:
        return "\n".join(lines) + "\n" + script
    return script


def resolve_session(flag: str | None) -> str | None:
    """-s flag, then $COLAB_SH_SESSION, then the active lease record."""
    if flag:
        return flag
    if os.environ.get("COLAB_SH_SESSION"):
        return os.environ["COLAB_SH_SESSION"]
    var = Path(os.environ.get("COLAB_RUNNER_VAR", REPO / "var"))
    try:
        rec = json.loads((var / "lease.json").read_text())
        return rec.get("session")
    except Exception:
        return None


def _lease_module():
    if str(REPO) not in sys.path:
        sys.path.insert(0, str(REPO))
    from sync import lease

    return lease


def live_state(session: str) -> str:
    """The target's server-side tri-state (alive/absent/unknown),
    read through the lease machinery's own funnel (bin/colab-run)
    and tri-state read (sync.lease.session_state). One seam, so the
    connect guard in main() is the only place that consults it."""
    from importlib.machinery import SourceFileLoader

    colab_run = SourceFileLoader("colab_run", str(REPO / "bin" / "colab-run")).load_module()
    return _lease_module().session_state(colab_run.colab, session)


def claim_caller(flag: str | None) -> tuple[str | None, str | None]:
    """Resolve the attach's caller claim (--caller flag over
    $COLAB_CALLER) through the lease core's registry. Returns
    (caller, error): a presented but unregistered claim is an
    error — refused at claim time. Attach is journal-only: an
    absent claim never blocks, it just leaves the attach
    unattributed in the journal."""
    lease = _lease_module()
    env = os.environ.get("COLAB_CALLER")
    err = lease.caller_claim_error(REPO, flag=flag, env=env)
    if err:
        return None, err
    return lease.resolve_caller(REPO, flag=flag, env=env), None


def journal_claim(session: str, caller: str | None) -> None:
    """Record the attach in the caller-claims journal (the
    attribution evidence for sessions outside lease records).
    Best-effort, like every journal in the lease core."""
    try:
        _lease_module().append_caller_claim(REPO, session, caller, "colab-sh")
    except Exception:  # noqa: BLE001
        pass


# --- Synchronous claim gate -----------------------------------------------------
# The gate binds this wrapper's synchronous mode only. sync_rights
# (sync/lease/syncclaims.py) is the one implementation; a gate
# error refuses — fail closed, like the liveness guard above —
# because an unreadable claim state is exactly when an unrecorded
# hold does its damage.

DETACHED_REMOTE_DIR = "/content/sync-detached"
_DETACH_ID = re.compile(r"[0-9A-Za-z-]{1,64}\Z")


def sync_gate(session: str, caller: str | None) -> dict | None:
    """The refusal verdict when the lease core denies this caller
    the synchronous channel, else None. The verdict is the core's
    own dict (blocked_by / holder / evidence / expires_at)."""
    try:
        verdict = _lease_module().sync_rights(REPO, session, caller)
    except Exception as err:  # noqa: BLE001
        return {"blocked_by": "error", "holder": None, "evidence": [], "expires_at": None, "error": str(err)}
    return None if verdict.get("allowed") else verdict


def _evidence_text(verdict: dict) -> str:
    parts = []
    for item in verdict.get("evidence") or []:
        kind = item.get("kind")
        if kind == "claim":
            parts.append(f"claim claimed at {item.get('claimed_at')}")
        elif kind == "run":
            parts.append(f"run {item.get('run_id')} ({item.get('state')})")
        elif kind == "job":
            parts.append(f"job {item.get('run_id')} registered on the lease record")
        elif kind == "attach":
            parts.append(f"attach via {item.get('seam')} at {item.get('ts')}")
    return "; ".join(parts) or "no detail"


def detached_alternative(args, session: str, caller: str | None, script_args: list) -> str:
    """The --detach form of the caller's own refused command: the
    async route that stays open to every caller."""
    parts = ["colab-sh", "--detach", "-s", session]
    if caller:
        parts += ["--caller", caller]
    if args.dir != "/content":
        parts += ["--dir", args.dir]
    for kv in args.env:
        parts += ["--env", kv]
    if args.file:
        parts += ["-f", args.file]
        if script_args:
            parts += ["--", *script_args]
    elif args.command:
        parts += ["--", *args.command]
    else:
        parts += ["<your-script-on-stdin>"]
    return " ".join(shlex.quote(p) if any(c in p for c in " <>") else p for p in parts)


def refusal_message(session: str, caller: str | None, verdict: dict, alternative: str) -> str:
    who = f"caller {caller!r}" if caller else "an unattributed caller"
    if verdict.get("blocked_by") == "error":
        head = f"the sync-claim check failed ({verdict.get('error')}); refusing — fail closed"
    elif verdict.get("blocked_by") == "claim":
        head = f"the sync claim is held by {verdict.get('holder')!r} until {verdict.get('expires_at')}"
    else:
        head = f"caller {verdict.get('holder')!r} is active on this session and synchronous use is off while multiple threads are active"
    return (
        f"colab-sh: synchronous attach to session {session!r} refused for {who} — {head} "
        f"(evidence: {_evidence_text(verdict)}).\n"
        f"Detached alternative (open to all callers): {alternative}"
    )


# --- Detached mode ----------------------------------------------------------------
# --detach launches the script in-session under nohup and returns
# at once; --poll reads its state with one short call. The launch
# and the poll are seconds-long connects — the sanctioned async
# path, open to every caller, never claim-gated.


def detach_id() -> str:
    return f"{datetime.now(timezone.utc):%Y%m%dT%H%M%SZ}-{secrets.token_hex(2)}"


def run_remote(session: str, script_text: str, timeout: float) -> subprocess.CompletedProcess:
    cmd = ssh_argv(session, "/content", [], DEFAULT_IDENTITY)
    return subprocess.run(
        cmd, input=script_text, text=True, capture_output=True,
        timeout=timeout, env=proxy_env(os.environ),
    )


def detach_launch(session: str, args, script: str, env_pairs: list, caller: str | None) -> int:
    did = detach_id()
    body = build_stdin(script, env_pairs)
    if args.dir != "/content":
        body = f"cd {shlex.quote(args.dir)}\n" + body
    payload_b64 = base64.b64encode(body.encode()).decode()
    meta = {
        "id": did, "session": session, "caller": caller,
        "started_at": datetime.now(timezone.utc).isoformat(), "state": "running",
    }
    lines = [
        "set -u",
        f"D={DETACHED_REMOTE_DIR}",
        'mkdir -p "$D"',
        f"printf %s {shlex.quote(payload_b64)} | base64 -d > \"$D/{did}.sh\"",
        f"cat > \"$D/{did}.json\" <<'META'",
        json.dumps(meta),
        "META",
        f"nohup bash -c 'bash \"$0\"; echo $? > \"$0.exit\"' \"$D/{did}.sh\" > \"$D/{did}.log\" 2>&1 &",
        f"echo $! > \"$D/{did}.pid\"",
        "",
    ]
    try:
        r = run_remote(session, "\n".join(lines), timeout=120)
    except subprocess.TimeoutExpired:
        print(f"colab-sh: detached launch timed out (session {session})", file=sys.stderr)
        return 124
    if r.returncode != 0:
        print(f"colab-sh: detached launch failed (ssh rc {r.returncode})", file=sys.stderr)
        return r.returncode
    print(json.dumps({"id": did, "session": session, "state": "running", "log": f"{DETACHED_REMOTE_DIR}/{did}.log"}))
    return 0


def detach_poll(session: str, did: str) -> int:
    if not _DETACH_ID.fullmatch(did):
        print(f"colab-sh: bad detached id {did!r}", file=sys.stderr)
        return 2
    lines = [
        "set -u",
        f"D={DETACHED_REMOTE_DIR}",
        f"ID={shlex.quote(did)}",
        'if [ ! -f "$D/$ID.json" ]; then echo NOT-FOUND; exit 0; fi',
        'cat "$D/$ID.json"',
        'if [ -f "$D/$ID.exit" ]; then echo "STATE done"; echo "EXIT $(cat "$D/$ID.exit")";',
        'elif [ -n "$(cat "$D/$ID.pid" 2>/dev/null)" ] && kill -0 "$(cat "$D/$ID.pid")" 2>/dev/null; then echo "STATE running"; echo "EXIT -";',
        'else echo "STATE exited-unrecorded"; echo "EXIT -"; fi',
        'echo ---LOG---',
        'tail -n 40 "$D/$ID.log" 2>/dev/null || true',
        "",
    ]
    try:
        r = run_remote(session, "\n".join(lines), timeout=120)
    except subprocess.TimeoutExpired:
        print(f"colab-sh: detached poll timed out (session {session})", file=sys.stderr)
        return 124
    if r.returncode != 0:
        print(f"colab-sh: detached poll failed (ssh rc {r.returncode})", file=sys.stderr)
        return r.returncode
    out = r.stdout
    if out.startswith("NOT-FOUND"):
        print(json.dumps({"id": did, "session": session, "state": "not-found"}))
        return 2
    meta_line, _, rest = out.partition("\n")
    try:
        meta = json.loads(meta_line)
    except json.JSONDecodeError:
        meta = {}
    state, exit_code, log_tail = "exited-unrecorded", None, ""
    for line in rest.splitlines():
        if line.startswith("STATE "):
            state = line.split(" ", 1)[1]
        elif line.startswith("EXIT "):
            raw = line.split(" ", 1)[1]
            exit_code = int(raw) if raw.lstrip("-").isdigit() else None
    if "---LOG---\n" in rest:
        log_tail = rest.split("---LOG---\n", 1)[1]
    print(json.dumps({"id": did, "session": session, "state": state, "exit_code": exit_code,
                      "caller": meta.get("caller"), "started_at": meta.get("started_at"),
                      "log_tail": log_tail}))
    if state == "done":
        return exit_code if exit_code is not None else 0
    if state == "exited-unrecorded":
        return 3
    return 0


def read_script(args) -> str | None:
    if args.file:
        return Path(args.file).read_text()
    if args.command:
        return " ".join(args.command) + "\n"
    if not sys.stdin.isatty():
        return sys.stdin.read()
    return None


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="colab-sh", description=__doc__.split("\n")[0])
    ap.add_argument("-s", "--session", help="session name (default: the active lease's)")
    ap.add_argument("--caller", help="caller claim: the thread doing this work (or $COLAB_CALLER); journaled per attach")
    ap.add_argument("--detach", action="store_true", help="launch the script detached in-session (nohup + log under /content/sync-detached) and return its id at once; the async path, open to all callers")
    ap.add_argument("--poll", metavar="ID", help="one short read of a detached launch's state + log tail; exits with the job's exit code once it is done")
    ap.add_argument("-f", "--file", help="shell script file to run")
    ap.add_argument("--dir", default="/content", help="remote working directory")
    ap.add_argument("--timeout", type=float, default=900, help="seconds (default 900)")
    ap.add_argument("--env", action="append", default=[], metavar="K=V",
                    help="environment variable for the remote script; repeatable")
    ap.add_argument("command", nargs="*", help="inline command (or after --, script args with -f)")
    args, script_args = ap.parse_known_args(argv)
    # argparse puts everything after `--` in script_args only when it
    # follows the options; positionals before `--` are the command.
    if args.file and args.command:
        script_args = args.command + script_args
        args.command = []

    caller, claim_err = claim_caller(args.caller)
    if claim_err:
        print(f"colab-sh: {claim_err}", file=sys.stderr)
        return 2
    session = resolve_session(args.session)
    if not session:
        print("colab-sh: no session (no -s, no $COLAB_SH_SESSION, no lease record)", file=sys.stderr)
        return 2
    identity = DEFAULT_IDENTITY
    if not identity.exists():
        print(f"colab-sh: identity key {identity} missing (server accepts ed25519/ecdsa only)", file=sys.stderr)
        return 2
    if not CLI_VENV_PYTHON.exists():
        print(f"colab-sh: colab CLI venv python missing at {CLI_VENV_PYTHON}", file=sys.stderr)
        return 2
    # Existing sessions only — enforced, not assumed. The CLI's ssh
    # flow assigns a fresh default-shape (Standard) runtime when the
    # named session has no live assignment, so probing a dead or
    # stale profile name silently mints one (2026-11-04: lane probes
    # of two dead profile names created Standard runtimes under
    # both, each behind its own approval card). Refuse unless the
    # machinery's own read calls the session alive.
    try:
        state = live_state(session)
    except Exception:  # noqa: BLE001
        state = "unknown"
    if state != "alive":
        print(
            f"colab-sh: session {session!r} is not live (state: {state}); refusing to connect — "
            "the CLI's ssh flow would create a new runtime. Attach to the lease record's session instead.",
            file=sys.stderr,
        )
        return 2
    if args.poll is not None:
        # A poll is a seconds-long read of in-session state — the
        # async path, never claim-gated. The attach is journaled
        # like any other: attribution is evidence.
        journal_claim(session, caller)
        return detach_poll(session, args.poll)
    script = read_script(args)
    if script is None or not script.strip():
        print("colab-sh: no script (pass a command, -f FILE, or pipe stdin)", file=sys.stderr)
        return 2
    env_pairs = []
    for item in args.env:
        if "=" not in item:
            print(f"colab-sh: invalid --env {item!r} (expected K=V)", file=sys.stderr)
            return 2
        env_pairs.append(tuple(item.split("=", 1)))

    # Wrapper parity: restore transient state on entry (best-effort).
    try:
        subprocess.run(
            [sys.executable, str(REPO / "ops" / "mirror_transient.py"), "restore"],
            capture_output=True, timeout=120,
        )
    except Exception:
        pass

    if args.detach:
        # The launch is a seconds-long connect that starts
        # in-session work and disconnects — open to every caller,
        # never claim-gated.
        journal_claim(session, caller)
        return detach_launch(session, args, script, env_pairs, caller)

    # The synchronous gate: the lease core's verdict, evaluated
    # after liveness and caller resolution, before connecting. A
    # refusal names the holder, the evidence, and the detached
    # form of this very command.
    verdict = sync_gate(session, caller)
    if verdict is not None:
        print(refusal_message(session, caller, verdict,
                              detached_alternative(args, session, caller, script_args)), file=sys.stderr)
        return 2

    # The attach is real from here: journal its caller claim.
    journal_claim(session, caller)
    cmd = ssh_argv(session, args.dir, script_args, identity)
    try:
        r = subprocess.run(
            cmd,
            input=build_stdin(script, env_pairs),
            text=True,
            timeout=args.timeout,
            env=proxy_env(os.environ),
        )
    except subprocess.TimeoutExpired:
        print(f"colab-sh: timed out after {args.timeout}s (session {session})", file=sys.stderr)
        return 124
    except FileNotFoundError:
        print("colab-sh: system ssh not found", file=sys.stderr)
        return 2
    return r.returncode


if __name__ == "__main__":
    raise SystemExit(main())
