# Transient mirror: restore state, never source. Contents are secrets-adjacent
# (OAuth token, session state) and must never be committed.
/state/transient/*
!/state/transient/README.md

# Local repo registry: which target repos this machine provisions is local
# data, seeded from the tracked config/repos.example.json — never committed.
/config/repos.json

# Local workload profiles: which named profiles, sessions, default, and
# measured rates this workspace uses are local data, seeded from the
# tracked config/profiles.example.json — never committed.
/config/profiles.json

# Local caller registry: which named threads may claim caller identity
# at the wrapper seams is local data, seeded from the tracked
# config/callers.example.json — never committed.
/config/callers.json

# Job results: manifests are tracked under jobs/; payload bytes are not.
/results/*
!/results/.gitkeep

# Probe payloads and scratch
/probes/results/*.bin
/var/
*.bundle
__pycache__/
.pytest_cache/

# Working state is not tracked source (standing ruling, the sibling
# repos' rule): plans and workbench bundle todos are harness working
# documents — the harness runs on the files, not the git index.
.plans/

# Probe run outputs are run records, not source.
probes/results/*.json

# Landed mockups are transient design material; the shipped UI and
# the docs are the durable record.
ui/mockups/

# Icon PNGs are generated from the tracked SVG (ui/make-icon-png.sh);
# regenerable data is not tracked.
ui/static/colab-icon-*.png
